{
  "name": "unkernel",
  "version": "0.1.0",
  "description": "Linux on WebAssembly: boot an Alpine riscv64 userland in Node or the browser",
  "license": "MIT AND GPL-2.0-only",
  "author": "Pooya Parsa <pooya@pi0.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithings/unkernel.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "default": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      }
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    },
    "./alpine.wasm": "./dist/unkernel-alpine.wasm",
    "./package.json": "./package.json"
  },
  "types": "./dist/node.d.mts",
  "bin": {
    "unkernel": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "obuild",
    "typecheck": "tsc -p .",
    "test": "pnpm typecheck && pnpm test:block && pnpm test:net && pnpm test:tty && pnpm test:http && pnpm test:9p",
    "test:block": "node --test test/block.test.ts",
    "test:net": "node --test test/net.test.ts",
    "test:tty": "node --test test/tty.test.ts",
    "test:9p": "node --test test/9p.test.ts",
    "test:http": "node --test test/http.test.ts",
    "test:kpatch": "node --test test/kpatch.test.ts",
    "test:wasi": "node test/wasi-node.ts",
    "test:api": "node --test test/api.test.ts",
    "unkernel": "node js/cli.ts",
    "dev": "pnpm -C web dev",
    "build:web": "pnpm -C web build",
    "start:web": "pnpm -C web start",
    "typecheck:web": "pnpm -C web typecheck",
    "test:web": "node web/test/headless.mjs",
    "test:web:smp": "node web/test/smp.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "obuild": "^0.4.45",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.14.0"
}
