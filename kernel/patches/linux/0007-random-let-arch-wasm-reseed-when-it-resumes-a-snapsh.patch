From dbe2bbe242453e7ad7cd8719d18f88d734f98fce Mon Sep 17 00:00:00 2001
From: Pooya Parsa <pooya@pi0.io>
Date: Sun, 15 Nov 2026 14:06:30 +0000
Subject: [PATCH] random: let arch/wasm reseed when it resumes a snapshot

add_vmfork_randomness() exists only with CONFIG_VMGENID, the ACPI and
device tree driver for a hypervisor's VM generation ID. arch/wasm resumes
snapshots itself (CONFIG_KW_PARK) and needs the same reseed, so that two
machines resumed from one snapshot do not share the CRNG's output. Build
it, and the vmfork notifier chain, with CONFIG_KW_PARK as well.
---
 drivers/char/random.c  | 3 ++-
 include/linux/random.h | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/drivers/char/random.c b/drivers/char/random.c
index b4da1fb97..8e7ef9a9b 100644
--- a/drivers/char/random.c
+++ b/drivers/char/random.c
@@ -967,7 +967,8 @@ void __init add_bootloader_randomness(const void *buf, size_t len)
 		credit_init_bits(len * 8);
 }
 
-#if IS_ENABLED(CONFIG_VMGENID)
+/* arch/wasm (CONFIG_KW_PARK) calls it when it resumes from a snapshot. */
+#if IS_ENABLED(CONFIG_VMGENID) || IS_ENABLED(CONFIG_KW_PARK)
 static BLOCKING_NOTIFIER_HEAD(vmfork_chain);
 
 /*
diff --git a/include/linux/random.h b/include/linux/random.h
index 8a8064dc3..2ebe80829 100644
--- a/include/linux/random.h
+++ b/include/linux/random.h
@@ -27,7 +27,7 @@ static inline void add_latent_entropy(void)
 #endif
 }
 
-#if IS_ENABLED(CONFIG_VMGENID)
+#if IS_ENABLED(CONFIG_VMGENID) || IS_ENABLED(CONFIG_KW_PARK)
 void add_vmfork_randomness(const void *unique_vm_id, size_t len);
 int register_random_vmfork_notifier(struct notifier_block *nb);
 int unregister_random_vmfork_notifier(struct notifier_block *nb);
-- 
2.56.0

