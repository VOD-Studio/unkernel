From 7b9b1b53ab91196ef2fcd845006c8fe8eb741dc3 Mon Sep 17 00:00:00 2001
From: Pooya Parsa <pooya@pi0.io>
Date: Sun, 15 Nov 2026 10:16:09 +0000
Subject: [PATCH] wasm: kwnet, an Ethernet device backed by the JavaScript host

Frames are copied to and from the host through four imports
(wasm_driver_net_init/send/rx_len/recv). The host queues received
frames and raises WASM_IRQ_NET (2) in wasm_host_irqs; like the timer
and console input, it is polled when user mode returns to the kernel
and in the idle loop, and schedules NAPI, which drains the queue into
GRO.

The host terminates the link itself (a user-mode TCP/IP stack), so the
device claims checksum offload, SG and TSO and marks received frames
CHECKSUM_UNNECESSARY: the guest computes no checksums and hands 64 KiB
TCP segments to the host. Without a host network
(wasm_driver_net_init() < 0) no device is registered.

Signed-off-by: Pooya Parsa <pooya@pi0.io>
---
 drivers/net/Kconfig  |   8 ++
 drivers/net/Makefile |   1 +
 drivers/net/kwnet.c  | 198 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 207 insertions(+)
 create mode 100644 drivers/net/kwnet.c

diff --git a/drivers/net/Kconfig b/drivers/net/Kconfig
index ff79c4667..d73c2c27d 100644
--- a/drivers/net/Kconfig
+++ b/drivers/net/Kconfig
@@ -56,6 +56,14 @@ config BONDING
 	  To compile this driver as a module, choose M here: the module
 	  will be called bonding.
 
+config KWNET
+	bool "unkernel host network device"
+	depends on WASM
+	default y
+	help
+	  Ethernet device whose frames are exchanged with the JavaScript
+	  host of a unkernel instance (js/core/net.ts).
+
 config DUMMY
 	tristate "Dummy net driver support"
 	help
diff --git a/drivers/net/Makefile b/drivers/net/Makefile
index 88e4c485d..b78b6e99c 100644
--- a/drivers/net/Makefile
+++ b/drivers/net/Makefile
@@ -10,6 +10,7 @@ obj-$(CONFIG_BONDING) += bonding/
 obj-$(CONFIG_IPVLAN) += ipvlan/
 obj-$(CONFIG_IPVTAP) += ipvlan/
 obj-$(CONFIG_DUMMY) += dummy.o
+obj-$(CONFIG_KWNET) += kwnet.o
 obj-$(CONFIG_WIREGUARD) += wireguard/
 obj-$(CONFIG_OVPN) += ovpn/
 obj-$(CONFIG_EQUALIZER) += eql.o
diff --git a/drivers/net/kwnet.c b/drivers/net/kwnet.c
new file mode 100644
index 000000000..58d472e59
--- /dev/null
+++ b/drivers/net/kwnet.c
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * kwnet: Ethernet device backed by the JavaScript host (unkernel).
+ *
+ * Frames are copied to and from the host through imports. The host queues
+ * received frames and raises WASM_IRQ_NET in wasm_host_irqs; the interrupt
+ * is polled like the timer and console input (when user mode traps back into
+ * the kernel, and in the idle loop), and schedules NAPI, which drains the
+ * host queue.
+ *
+ * The host terminates the link itself (a user-mode TCP/IP stack), so it does
+ * not need checksums: the device claims checksum offload and TSO, and marks
+ * received frames CHECKSUM_UNNECESSARY.
+ */
+
+#include <linux/etherdevice.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/netdevice.h>
+#include <linux/skbuff.h>
+#include <asm/irq.h>
+#include <asm/wasm.h>
+
+/* Host imports, module "unkernel" (js/core/kernel.ts). */
+/* Returns < 0 when the host has no network; fills the MAC address. */
+long wasm_driver_net_init(u8 *mac)
+	__unkernel_import(wasm_driver_net_init);
+/* Hand one frame to the host (copied before returning). */
+long wasm_driver_net_send(const void *buf, size_t len)
+	__unkernel_import(wasm_driver_net_send);
+/* Length of the next queued frame, 0 if none. */
+long wasm_driver_net_rx_len(void)
+	__unkernel_import(wasm_driver_net_rx_len);
+/* Copy the next frame into @buf (at most @max bytes) and dequeue it. */
+long wasm_driver_net_recv(void *buf, size_t max)
+	__unkernel_import(wasm_driver_net_recv);
+
+#define KWNET_MAX_FRAME	(ETH_HLEN + 65535)
+
+static unsigned int mtu = ETH_DATA_LEN;
+module_param(mtu, uint, 0444);
+MODULE_PARM_DESC(mtu, "initial MTU (default 1500)");
+
+struct kwnet {
+	struct net_device *dev;
+	struct napi_struct napi;
+	u8 *bounce;			/* TX linearisation buffer */
+};
+
+static int kwnet_poll(struct napi_struct *napi, int budget)
+{
+	struct kwnet *priv = container_of(napi, struct kwnet, napi);
+	struct net_device *dev = priv->dev;
+	int done = 0;
+
+	while (done < budget) {
+		long len = wasm_driver_net_rx_len();
+		struct sk_buff *skb;
+
+		if (len <= 0)
+			break;
+		skb = napi_alloc_skb(napi, len);
+		if (!skb) {
+			wasm_driver_net_recv(NULL, 0);	/* drop it */
+			dev->stats.rx_dropped++;
+			continue;
+		}
+		wasm_driver_net_recv(skb_put(skb, len), len);
+		skb->protocol = eth_type_trans(skb, dev);
+		skb->ip_summed = CHECKSUM_UNNECESSARY;
+		dev->stats.rx_packets++;
+		dev->stats.rx_bytes += len;
+		napi_gro_receive(napi, skb);
+		done++;
+	}
+
+	if (done < budget && napi_complete_done(napi, done) &&
+	    wasm_driver_net_rx_len() > 0)
+		napi_schedule(napi);
+	return done;
+}
+
+static irqreturn_t kwnet_irq(int irq, void *dev_id)
+{
+	struct kwnet *priv = netdev_priv(dev_id);
+
+	napi_schedule(&priv->napi);
+	return IRQ_HANDLED;
+}
+
+static netdev_tx_t kwnet_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+	struct kwnet *priv = netdev_priv(dev);
+	const void *data = skb->data;
+
+	if (skb->len > KWNET_MAX_FRAME) {
+		dev->stats.tx_dropped++;
+		goto out;
+	}
+	if (skb_is_nonlinear(skb)) {
+		skb_copy_bits(skb, 0, priv->bounce, skb->len);
+		data = priv->bounce;
+	}
+	wasm_driver_net_send(data, skb->len);
+	dev->stats.tx_packets++;
+	dev->stats.tx_bytes += skb->len;
+out:
+	dev_consume_skb_any(skb);
+	return NETDEV_TX_OK;
+}
+
+static int kwnet_open(struct net_device *dev)
+{
+	struct kwnet *priv = netdev_priv(dev);
+
+	napi_enable(&priv->napi);
+	netif_carrier_on(dev);
+	netif_start_queue(dev);
+	/* Frames may have been queued while the device was down. */
+	if (wasm_driver_net_rx_len() > 0)
+		napi_schedule(&priv->napi);
+	return 0;
+}
+
+static int kwnet_stop(struct net_device *dev)
+{
+	struct kwnet *priv = netdev_priv(dev);
+
+	netif_stop_queue(dev);
+	netif_carrier_off(dev);
+	napi_disable(&priv->napi);
+	return 0;
+}
+
+static const struct net_device_ops kwnet_ops = {
+	.ndo_open		= kwnet_open,
+	.ndo_stop		= kwnet_stop,
+	.ndo_start_xmit		= kwnet_xmit,
+	.ndo_set_mac_address	= eth_mac_addr,
+	.ndo_validate_addr	= eth_validate_addr,
+};
+
+static int __init kwnet_init(void)
+{
+	struct net_device *dev;
+	struct kwnet *priv;
+	u8 mac[ETH_ALEN];
+	int err;
+
+	if (wasm_driver_net_init(mac) < 0) {
+		pr_info("kwnet: no host network\n");
+		return 0;
+	}
+
+	dev = alloc_etherdev(sizeof(*priv));
+	if (!dev)
+		return -ENOMEM;
+	priv = netdev_priv(dev);
+	priv->dev = dev;
+	priv->bounce = kvmalloc(KWNET_MAX_FRAME, GFP_KERNEL);
+	if (!priv->bounce) {
+		err = -ENOMEM;
+		goto err_free;
+	}
+
+	dev->netdev_ops = &kwnet_ops;
+	dev->hw_features = NETIF_F_SG | NETIF_F_HW_CSUM | NETIF_F_TSO;
+	dev->features = dev->hw_features | NETIF_F_RXCSUM;
+	dev->max_mtu = 65535 - ETH_HLEN - 4;
+	dev->mtu = clamp_t(unsigned int, mtu, ETH_MIN_MTU, dev->max_mtu);
+	if (is_valid_ether_addr(mac))
+		eth_hw_addr_set(dev, mac);
+	else
+		eth_hw_addr_random(dev);
+	netif_napi_add(dev, &priv->napi, kwnet_poll);
+	netif_carrier_off(dev);
+
+	err = request_irq(WASM_IRQ_NET, kwnet_irq, 0, "kwnet", dev);
+	if (err)
+		goto err_napi;
+	err = register_netdev(dev);
+	if (err)
+		goto err_irq;
+	netdev_info(dev, "kwnet host network, MAC %pM, MTU %u\n",
+		    dev->dev_addr, dev->mtu);
+	return 0;
+
+err_irq:
+	free_irq(WASM_IRQ_NET, dev);
+err_napi:
+	netif_napi_del(&priv->napi);
+	kvfree(priv->bounce);
+err_free:
+	free_netdev(dev);
+	return err;
+}
+device_initcall(kwnet_init);
-- 
2.56.0

