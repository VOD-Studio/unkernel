--- /dev/null
+++ b/arch/wasm/include/asm/hwcap.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_HWCAP_H
+#define _ASM_WASM_HWCAP_H
+
+#include <uapi/asm/hwcap.h>
+
+/* rv64imafdc ("rv64gc" minus Zicsr/Zifencei, which have no bits). */
+#define KW_RISCV_HWCAP	(COMPAT_HWCAP_ISA_I | COMPAT_HWCAP_ISA_M | \
+			 COMPAT_HWCAP_ISA_A | COMPAT_HWCAP_ISA_F | \
+			 COMPAT_HWCAP_ISA_D | COMPAT_HWCAP_ISA_C)
+
+#ifndef __ASSEMBLY__
+#include <linux/types.h>
+
+struct kw_cpu;
+
+/*
+ * The multi-letter extensions user space sees (cpu.c): kw.isa= masks them,
+ * kw_isa_init() picks the effective set once at boot, and /proc/cpuinfo and
+ * riscv_hwprobe report it.
+ */
+void kw_isa_init(struct kw_cpu *cpu);
+u64 kw_isa_hwprobe_ext0(void);
+u64 kw_isa_hwprobe_ext1(void);
+#endif
+
+#endif /* _ASM_WASM_HWCAP_H */
