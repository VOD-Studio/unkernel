diff --git a/arch/wasm/kernel/cpu.c b/arch/wasm/kernel/cpu.c
new file mode 100644
index 000000000..d5bb65ac3
--- /dev/null
+++ b/arch/wasm/kernel/cpu.c
@@ -0,0 +1,221 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <linux/bits.h>
+#include <linux/cpu.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+#include <asm/hwcap.h>
+#include <asm/hwprobe.h>
+#include <asm/kw_emu.h>
+
+/*
+ * The riscv ISA extensions user space can detect, in the canonical order of
+ * riscv_isa_ext[] (arch/riscv/kernel/cpufeature.c), which is also the order
+ * of the "isa" line of /proc/cpuinfo. One effective set feeds both that line
+ * and riscv_hwprobe's IMA_EXT_0 and IMA_EXT_1; AT_HWCAP has single letters
+ * only and stays IMAFDC.
+ *
+ * kw is the kwemu bit (KW_ISA_*): the extension is on only if kwemu
+ * implements it (kw_set_isa). kw = 0 marks one that every kwemu has: part of
+ * RV64GC (zicntr, zaamo, zalrsc, zca, zcd), hints that run as no-ops
+ * (zicbop, zihintntl, zihintpause) or a property of the platform, which
+ * holds in the interpreter and the JIT alike:
+ *  - ziccamoa: every AMO and LR/SC works on all of user memory (misaligned
+ *    ones raise SIGBUS, which the property allows);
+ *  - ziccif: instructions run from any executable page, a naturally
+ *    aligned one is fetched with a single load, and a store into code is
+ *    seen by the next instruction;
+ *  - zicclsm: misaligned scalar and FP loads and stores work, also across
+ *    pages, without a trap;
+ *  - ziccrse: an LR/SC loop of the constrained kind eventually succeeds, as
+ *    the single hart's reservation is only dropped by a context switch, a
+ *    signal or sigreturn;
+ *  - za64rs: the reservation set is the one address of the LR, so within a
+ *    naturally aligned 64-byte block.
+ * Masking one of those only stops advertising it. Base entries are part of
+ * rv64gc and always on.
+ */
+struct kw_isa_ext {
+	const char *name;
+	u64 kw;
+	u64 ext0;	/* bit in RISCV_HWPROBE_KEY_IMA_EXT_0, or 0 */
+	u64 ext1;	/* bit in RISCV_HWPROBE_KEY_IMA_EXT_1, or 0 */
+	bool base;
+};
+
+#define KW_EXT(n, k, h)	{ #n, k, h, 0, false }
+#define KW_EXT1(n, h)	{ #n, 0, 0, h, false }
+#define KW_BASE(n)	{ #n, 0, 0, 0, true }
+
+static const struct kw_isa_ext kw_isa_exts[] = {
+	KW_EXT(zicbom, KW_ISA_ZICBOM, RISCV_HWPROBE_EXT_ZICBOM),
+	KW_EXT(zicbop, 0, RISCV_HWPROBE_EXT_ZICBOP),
+	KW_EXT(zicboz, KW_ISA_ZICBOZ, RISCV_HWPROBE_EXT_ZICBOZ),
+	KW_EXT1(ziccamoa, RISCV_HWPROBE_EXT_ZICCAMOA),
+	KW_EXT1(ziccif, RISCV_HWPROBE_EXT_ZICCIF),
+	KW_EXT1(zicclsm, RISCV_HWPROBE_EXT_ZICCLSM),
+	KW_EXT1(ziccrse, RISCV_HWPROBE_EXT_ZICCRSE),
+	KW_EXT(zicntr, 0, RISCV_HWPROBE_EXT_ZICNTR),
+	KW_EXT(zicond, KW_ISA_ZICOND, RISCV_HWPROBE_EXT_ZICOND),
+	KW_BASE(zicsr),
+	KW_BASE(zifencei),
+	KW_EXT(zihintntl, 0, RISCV_HWPROBE_EXT_ZIHINTNTL),
+	KW_EXT(zihintpause, 0, RISCV_HWPROBE_EXT_ZIHINTPAUSE),
+	KW_EXT(zihpm, KW_ISA_ZIHPM, RISCV_HWPROBE_EXT_ZIHPM),
+	KW_EXT(zimop, KW_ISA_ZIMOP, RISCV_HWPROBE_EXT_ZIMOP),
+	KW_EXT1(za64rs, RISCV_HWPROBE_EXT_ZA64RS),
+	KW_EXT(zaamo, 0, RISCV_HWPROBE_EXT_ZAAMO),
+	KW_EXT(zalrsc, 0, RISCV_HWPROBE_EXT_ZALRSC),
+	KW_EXT(zawrs, KW_ISA_ZAWRS, RISCV_HWPROBE_EXT_ZAWRS),
+	KW_EXT(zfa, KW_ISA_ZFA, RISCV_HWPROBE_EXT_ZFA),
+	KW_EXT(zfhmin, KW_ISA_ZFHMIN, RISCV_HWPROBE_EXT_ZFHMIN),
+	KW_EXT(zca, 0, RISCV_HWPROBE_EXT_ZCA),
+	KW_EXT(zcb, KW_ISA_ZCB, RISCV_HWPROBE_EXT_ZCB),
+	KW_EXT(zcd, 0, RISCV_HWPROBE_EXT_ZCD),
+	KW_EXT(zcmop, KW_ISA_ZCMOP, RISCV_HWPROBE_EXT_ZCMOP),
+	KW_EXT(zba, KW_ISA_ZBA, RISCV_HWPROBE_EXT_ZBA),
+	KW_EXT(zbb, KW_ISA_ZBB, RISCV_HWPROBE_EXT_ZBB),
+	KW_EXT(zbc, KW_ISA_ZBC, RISCV_HWPROBE_EXT_ZBC),
+	KW_EXT(zbkb, KW_ISA_ZBKB, RISCV_HWPROBE_EXT_ZBKB),
+	KW_EXT(zbkc, KW_ISA_ZBKC, RISCV_HWPROBE_EXT_ZBKC),
+	KW_EXT(zbkx, KW_ISA_ZBKX, RISCV_HWPROBE_EXT_ZBKX),
+	KW_EXT(zbs, KW_ISA_ZBS, RISCV_HWPROBE_EXT_ZBS),
+	KW_EXT(zknd, KW_ISA_ZKND, RISCV_HWPROBE_EXT_ZKND),
+	KW_EXT(zkne, KW_ISA_ZKNE, RISCV_HWPROBE_EXT_ZKNE),
+};
+
+/* Entries (bit i = kw_isa_exts[i]) the command line leaves on. */
+static u64 kw_isa_want __initdata = ~0ULL;
+/* What user space sees; the defaults are RV64GC alone. */
+static char kw_isa_str[256] __ro_after_init = "rv64imafdc_zicsr_zifencei";
+static u64 kw_isa_ext0 __ro_after_init = RISCV_HWPROBE_IMA_FD | RISCV_HWPROBE_IMA_C;
+static u64 kw_isa_ext1 __ro_after_init;
+
+/*
+ * kw.isa=LIST: a comma-separated list applied from left to right.
+ * "rv64gc" turns every extension beyond RV64GC off, "-ext" turns one off,
+ * "+ext" (or "ext") turns one back on if kwemu implements it. For example
+ * kw.isa=rv64gc, kw.isa=-zbc,-zkne or kw.isa=rv64gc,+zbb.
+ */
+static int __init kw_isa_param(char *arg)
+{
+	char *tok;
+
+	if (!arg)
+		return -EINVAL;
+	while ((tok = strsep(&arg, ",")) != NULL) {
+		bool on = true;
+		int i;
+
+		if (!*tok)
+			continue;
+		if (!strcmp(tok, "rv64gc")) {
+			for (i = 0; i < ARRAY_SIZE(kw_isa_exts); i++)
+				if (!kw_isa_exts[i].base)
+					kw_isa_want &= ~BIT_ULL(i);
+			continue;
+		}
+		if (*tok == '-' || *tok == '+')
+			on = *tok++ == '+';
+		for (i = 0; i < ARRAY_SIZE(kw_isa_exts); i++)
+			if (!strcmp(tok, kw_isa_exts[i].name))
+				break;
+		if (i == ARRAY_SIZE(kw_isa_exts) || kw_isa_exts[i].base) {
+			pr_warn("kw.isa: ignoring '%s'\n", tok);
+			continue;
+		}
+		if (on)
+			kw_isa_want |= BIT_ULL(i);
+		else
+			kw_isa_want &= ~BIT_ULL(i);
+	}
+	return 0;
+}
+early_param("kw.isa", kw_isa_param);
+
+/* Called once at boot, after kw_cpu_init and before any user code runs. */
+void __init kw_isa_init(struct kw_cpu *cpu)
+{
+	char *p = kw_isa_str, *end = kw_isa_str + sizeof(kw_isa_str);
+	u64 want = 0, got;
+	int i;
+
+	BUILD_BUG_ON(ARRAY_SIZE(kw_isa_exts) > 64);
+	for (i = 0; i < ARRAY_SIZE(kw_isa_exts); i++)
+		if (kw_isa_want & BIT_ULL(i))
+			want |= kw_isa_exts[i].kw;
+	got = kw_set_isa(cpu, want);
+
+	p += scnprintf(p, end - p, "rv64imafdc");
+	kw_isa_ext0 = RISCV_HWPROBE_IMA_FD | RISCV_HWPROBE_IMA_C;
+	kw_isa_ext1 = 0;
+	for (i = 0; i < ARRAY_SIZE(kw_isa_exts); i++) {
+		const struct kw_isa_ext *e = &kw_isa_exts[i];
+
+		if (!e->base && (!(kw_isa_want & BIT_ULL(i)) || (e->kw & ~got)))
+			continue;
+		p += scnprintf(p, end - p, "_%s", e->name);
+		kw_isa_ext0 |= e->ext0;
+		kw_isa_ext1 |= e->ext1;
+	}
+	pr_info("kwemu: isa %s (kwemu implements %#llx, enabled %#llx)\n",
+		kw_isa_str, kw_isa_supported(), got);
+}
+
+u64 kw_isa_hwprobe_ext0(void)
+{
+	return kw_isa_ext0;
+}
+
+u64 kw_isa_hwprobe_ext1(void)
+{
+	return kw_isa_ext1;
+}
+
+#ifdef CONFIG_PROC_FS
+
+static void *c_start(struct seq_file *m, loff_t *pos)
+{
+	if (*pos == nr_cpu_ids)
+		return NULL;
+
+	*pos = cpumask_next(*pos - 1, cpu_online_mask);
+	if ((*pos) < nr_cpu_ids)
+		return (void *)(uintptr_t)(1 + *pos);
+	return NULL;
+}
+
+static void *c_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	(*pos)++;
+	return c_start(m, pos);
+}
+
+static void c_stop(struct seq_file *m, void *v)
+{
+}
+
+static int c_show(struct seq_file *m, void *v)
+{
+	unsigned long cpu_id = (unsigned long)v - 1;
+
+	seq_printf(m, "processor\t: %lu\n", cpu_id);
+	seq_printf(m, "hart\t\t: %lu\n", cpu_id);
+	seq_printf(m, "isa\t\t: %s\n", kw_isa_str);
+	seq_printf(m, "mmu\t\t: sv39\n");
+	seq_printf(m, "uarch\t\t: unkernel,kwemu\n\n");
+
+	return 0;
+}
+
+const struct seq_operations cpuinfo_op = {
+	.start	= c_start,
+	.next	= c_next,
+	.stop	= c_stop,
+	.show	= c_show,
+};
+
+#endif /* CONFIG_PROC_FS */
diff --git a/arch/wasm/kernel/sys_riscv.c b/arch/wasm/kernel/sys_riscv.c
new file mode 100644
index 000000000..5ac304376
--- /dev/null
+++ b/arch/wasm/kernel/sys_riscv.c
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* riscv64-specific syscalls, as seen by user mode. */
+
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <asm/hwcap.h>
+#include <asm/hwprobe.h>
+
+#define SYS_RISCV_FLUSH_ICACHE_ALL 1UL
+#include <asm/kw_emu.h>
+
+extern struct kw_cpu *const wasm_kw_cpu;
+
+SYSCALL_DEFINE6(mmap, unsigned long, addr, unsigned long, len,
+		unsigned long, prot, unsigned long, flags,
+		unsigned long, fd, unsigned long, offset)
+{
+	if (unlikely(offset & (~PAGE_MASK)))
+		return -EINVAL;
+
+	return ksys_mmap_pgoff(addr, len, prot, flags, fd, offset >> PAGE_SHIFT);
+}
+
+SYSCALL_DEFINE3(riscv_flush_icache, uintptr_t, start, uintptr_t, end,
+		uintptr_t, flags)
+{
+	if (flags & ~SYS_RISCV_FLUSH_ICACHE_ALL)
+		return -EINVAL;
+	/* Drop translations; the emulator re-decodes from memory. */
+	kw_flush_tlb_all(wasm_kw_cpu);
+	return 0;
+}
+
+static void hwprobe_one(struct riscv_hwprobe *pair)
+{
+	switch (pair->key) {
+	case RISCV_HWPROBE_KEY_MVENDORID:
+	case RISCV_HWPROBE_KEY_MARCHID:
+	case RISCV_HWPROBE_KEY_MIMPID:
+		pair->value = 0;
+		break;
+	case RISCV_HWPROBE_KEY_BASE_BEHAVIOR:
+		pair->value = RISCV_HWPROBE_BASE_BEHAVIOR_IMA;
+		break;
+	case RISCV_HWPROBE_KEY_IMA_EXT_0:
+		pair->value = kw_isa_hwprobe_ext0();
+		break;
+	case RISCV_HWPROBE_KEY_IMA_EXT_1:
+		pair->value = kw_isa_hwprobe_ext1();
+		break;
+	/*
+	 * kwemu runs a misaligned load or store like an aligned one (one
+	 * unaligned host access; only page-straddling ones take a slower
+	 * path), so it is several times faster than the same bytes one by
+	 * one: what upstream measures for FAST. No V, so no vector accesses.
+	 */
+	case RISCV_HWPROBE_KEY_CPUPERF_0:
+	case RISCV_HWPROBE_KEY_MISALIGNED_SCALAR_PERF:
+		pair->value = RISCV_HWPROBE_MISALIGNED_SCALAR_FAST;
+		break;
+	case RISCV_HWPROBE_KEY_MISALIGNED_VECTOR_PERF:
+		pair->value = RISCV_HWPROBE_MISALIGNED_VECTOR_UNSUPPORTED;
+		break;
+	/* kwemu's cache blocks are 64 bytes (cbo.zero zeroes that many). */
+	case RISCV_HWPROBE_KEY_ZICBOZ_BLOCK_SIZE:
+		pair->value = kw_isa_hwprobe_ext0() & RISCV_HWPROBE_EXT_ZICBOZ ? 64 : 0;
+		break;
+	case RISCV_HWPROBE_KEY_ZICBOM_BLOCK_SIZE:
+		pair->value = kw_isa_hwprobe_ext0() & RISCV_HWPROBE_EXT_ZICBOM ? 64 : 0;
+		break;
+	case RISCV_HWPROBE_KEY_ZICBOP_BLOCK_SIZE:
+		/* The prefetches are no-ops. */
+		pair->value = kw_isa_hwprobe_ext0() & RISCV_HWPROBE_EXT_ZICBOP ? 64 : 0;
+		break;
+	/* As riscv: the end of the user address space (Sv39). */
+	case RISCV_HWPROBE_KEY_HIGHEST_VIRT_ADDRESS:
+		pair->value = STACK_TOP_MAX;
+		break;
+	/* Not a T-Head, SiFive or MIPS hart: no vendor extensions. */
+	case RISCV_HWPROBE_KEY_VENDOR_EXT_THEAD_0:
+	case RISCV_HWPROBE_KEY_VENDOR_EXT_SIFIVE_0:
+	case RISCV_HWPROBE_KEY_VENDOR_EXT_MIPS_0:
+		pair->value = 0;
+		break;
+	/*
+	 * TIME_CSR_FREQ stays unknown: the time CSR counts instructions
+	 * (icount), so it has no frequency.
+	 */
+	default:
+		pair->key = -1;
+		pair->value = 0;
+		break;
+	}
+}
+
+SYSCALL_DEFINE5(riscv_hwprobe, struct riscv_hwprobe __user *, pairs,
+		size_t, pair_count, size_t, cpusetsize,
+		unsigned long __user *, cpus_user, unsigned int, flags)
+{
+	size_t i;
+
+	if (flags & ~RISCV_HWPROBE_WHICH_CPUS)
+		return -EINVAL;
+
+	for (i = 0; i < pair_count; i++) {
+		struct riscv_hwprobe pair;
+
+		if (copy_from_user(&pair.key, &pairs[i].key, sizeof(pair.key)))
+			return -EFAULT;
+		hwprobe_one(&pair);
+		if (copy_to_user(&pairs[i], &pair, sizeof(pair)))
+			return -EFAULT;
+	}
+	return 0;
+}
