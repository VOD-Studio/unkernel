From 637b2eb3ab0dad87546b416eab14a69f6bfc5c84 Mon Sep 17 00:00:00 2001
From: Pooya Parsa <pooya@pi0.io>
Date: Sun, 15 Nov 2026 10:16:09 +0000
Subject: [PATCH] wasm: kwblk, host-backed block devices

Block devices whose requests are served by the JavaScript host (a disk
image file under Node, HTTP range requests plus a copy-on-write overlay
in a browser), named wda, wdb, ...

->queue_rq() describes the request in its PDU (op, sector, direct-mapped
segment addresses) and passes it to the non-suspending import
wasm_driver_block_submit(), so it is fine in blk-mq's atomic dispatch
context. The host completes the request synchronously (return <= 0) or
later: it then writes the status into the PDU, queues it and raises
WASM_IRQ_BLOCK, whose handler reaps finished requests with
wasm_driver_block_reap() and ends them. Interrupts are polled on user
exits and in the idle loop, which the host wakes.

Read, write, flush (when the host reports a volatile cache), discard
and write-zeroes (when the host supports them).

Signed-off-by: Pooya Parsa <pooya@pi0.io>
---
 drivers/block/Kconfig  |   9 ++
 drivers/block/Makefile |   1 +
 drivers/block/kwblk.c  | 275 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 285 insertions(+)
 create mode 100644 drivers/block/kwblk.c

diff --git a/drivers/block/Kconfig b/drivers/block/Kconfig
index 858320b6e..bd25258ae 100644
--- a/drivers/block/Kconfig
+++ b/drivers/block/Kconfig
@@ -220,6 +220,15 @@ config BLK_DEV_NBD
 
 	  If unsure, say N.
 
+config BLK_DEV_KWBLK
+	bool "unkernel host-backed block devices"
+	depends on WASM
+	help
+	  Block devices whose I/O is served by the JavaScript host of a
+	  unkernel instance (a disk image file under Node, HTTP range
+	  requests with an in-memory overlay in a browser). The disks are
+	  named wda, wdb, ...
+
 config BLK_DEV_RAM
 	tristate "RAM block device support"
 	help
diff --git a/drivers/block/Makefile b/drivers/block/Makefile
index 2d8096eb8..644010475 100644
--- a/drivers/block/Makefile
+++ b/drivers/block/Makefile
@@ -19,6 +19,7 @@ obj-$(CONFIG_ATARI_FLOPPY)	+= ataflop.o
 obj-$(CONFIG_AMIGA_Z2RAM)	+= z2ram.o
 obj-$(CONFIG_N64CART)		+= n64cart.o
 obj-$(CONFIG_BLK_DEV_RAM)	+= brd.o
+obj-$(CONFIG_BLK_DEV_KWBLK)	+= kwblk.o
 obj-$(CONFIG_BLK_DEV_LOOP)	+= loop.o
 obj-$(CONFIG_SUNVDC)		+= sunvdc.o
 
diff --git a/drivers/block/kwblk.c b/drivers/block/kwblk.c
new file mode 100644
index 000000000..9a0591e9b
--- /dev/null
+++ b/drivers/block/kwblk.c
@@ -0,0 +1,275 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * kwblk: host-backed block devices for unkernel.
+ *
+ * The JavaScript host serves the I/O (a disk image file under Node, HTTP
+ * range requests plus an in-memory overlay in a browser). The interface is
+ * modelled on a simple DMA controller rather than on blocking calls:
+ *
+ *   - ->queue_rq() describes the request (op, sector, the direct-mapped
+ *     addresses of its segments) in the request's PDU and hands it to
+ *     wasm_driver_block_submit(). That import never suspends, so it is fine
+ *     in blk-mq's atomic dispatch context (no BLK_MQ_F_BLOCKING).
+ *   - The host either finishes the request at once (returns <= 0; the Node
+ *     file backend does pread/pwrite synchronously) or later (returns 1).
+ *     Late completions are written into the PDU's status, queued on the host
+ *     side, and signalled with WASM_IRQ_BLOCK, which is polled like any other
+ *     host interrupt (user-mode exits, the idle loop, which the host wakes).
+ *   - The interrupt handler reaps finished requests with
+ *     wasm_driver_block_reap() and ends them.
+ *
+ * The host may only touch kernel memory while the kernel is suspended in a
+ * JSPI import, so the data copies of asynchronous requests happen while the
+ * kernel idles or yields; the request's pages stay pinned until it ends.
+ *
+ * Disks are named wda, wdb, ... and probed once at boot from the host's list.
+ */
+
+#include <linux/blk-mq.h>
+#include <linux/blkdev.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+#include <asm/irq.h>
+#include <asm/wasm.h>
+
+#define KWBLK_MAX_DEVS		16
+#define KWBLK_MINORS		16
+#define KWBLK_MAX_SEGS		128
+#define KWBLK_QUEUE_DEPTH	32
+
+/* Shared with the host (js/core/block.ts); little-endian, packed. */
+enum {
+	KWBLK_OP_READ		= 0,
+	KWBLK_OP_WRITE		= 1,
+	KWBLK_OP_FLUSH		= 2,
+	KWBLK_OP_DISCARD	= 3,
+	KWBLK_OP_WRITE_ZEROES	= 4,
+};
+
+#define KWBLK_F_RO		(1U << 0)	/* read-only medium */
+#define KWBLK_F_FLUSH		(1U << 1)	/* volatile write cache: send flushes */
+#define KWBLK_F_DISCARD		(1U << 2)	/* accepts discard */
+#define KWBLK_F_WRITE_ZEROES	(1U << 3)	/* accepts write-zeroes */
+
+struct kwblk_info {
+	u64 size;		/* bytes */
+	u32 flags;		/* KWBLK_F_* */
+	u32 block_size;		/* logical block size, 0 = 512 */
+} __packed;
+
+struct kwblk_seg {
+	u64 addr;		/* linear (= physical = kernel virtual) address */
+	u64 len;
+} __packed;
+
+struct kwblk_req {
+	u32 dev;		/*  0 */
+	u32 op;			/*  4: KWBLK_OP_* */
+	u64 sector;		/*  8: 512-byte units */
+	u64 bytes;		/* 16: total length */
+	u32 nr_segs;		/* 24 */
+	s32 status;		/* 28: written by the host: 0 or -errno */
+	struct kwblk_seg segs[KWBLK_MAX_SEGS];	/* 32 */
+} __packed;
+
+/* Host imports, module "unkernel" (js/core/block.ts). */
+int wasm_driver_block_info(u32 dev, struct kwblk_info *info)
+	__unkernel_import(wasm_driver_block_info);
+int wasm_driver_block_submit(struct kwblk_req *req)
+	__unkernel_import(wasm_driver_block_submit);
+struct kwblk_req *wasm_driver_block_reap(void)
+	__unkernel_import(wasm_driver_block_reap);
+
+struct kwblk_dev {
+	u32 index;
+	struct kwblk_info info;
+	struct blk_mq_tag_set tag_set;
+	struct gendisk *disk;
+};
+
+static int kwblk_major;
+static unsigned int kwblk_ndevs;
+
+static blk_status_t kwblk_queue_rq(struct blk_mq_hw_ctx *hctx,
+				   const struct blk_mq_queue_data *bd)
+{
+	struct kwblk_dev *kd = hctx->queue->queuedata;
+	struct request *rq = bd->rq;
+	struct kwblk_req *req = blk_mq_rq_to_pdu(rq);
+	struct req_iterator iter;
+	struct bio_vec bv;
+	unsigned int n = 0;
+	int ret;
+
+	req->dev = kd->index;
+	req->sector = blk_rq_pos(rq);
+	req->bytes = blk_rq_bytes(rq);
+	req->status = 0;
+
+	switch (req_op(rq)) {
+	case REQ_OP_READ:
+		req->op = KWBLK_OP_READ;
+		break;
+	case REQ_OP_WRITE:
+		req->op = KWBLK_OP_WRITE;
+		break;
+	case REQ_OP_FLUSH:
+		req->op = KWBLK_OP_FLUSH;
+		break;
+	case REQ_OP_DISCARD:
+		req->op = KWBLK_OP_DISCARD;
+		break;
+	case REQ_OP_WRITE_ZEROES:
+		req->op = KWBLK_OP_WRITE_ZEROES;
+		break;
+	default:
+		return BLK_STS_NOTSUPP;
+	}
+
+	if (req->op == KWBLK_OP_READ || req->op == KWBLK_OP_WRITE) {
+		rq_for_each_segment(bv, rq, iter) {
+			u64 addr = (u64)(unsigned long)bvec_virt(&bv);
+
+			/* Merge physically contiguous pieces. */
+			if (n && req->segs[n - 1].addr + req->segs[n - 1].len == addr) {
+				req->segs[n - 1].len += bv.bv_len;
+				continue;
+			}
+			if (WARN_ON_ONCE(n == KWBLK_MAX_SEGS))
+				return BLK_STS_IOERR;
+			req->segs[n].addr = addr;
+			req->segs[n].len = bv.bv_len;
+			n++;
+		}
+	}
+	req->nr_segs = n;
+
+	blk_mq_start_request(rq);
+	ret = wasm_driver_block_submit(req);
+	if (ret <= 0)
+		blk_mq_end_request(rq, errno_to_blk_status(ret));
+	/* else: completion arrives through WASM_IRQ_BLOCK */
+	return BLK_STS_OK;
+}
+
+static irqreturn_t kwblk_irq(int irq, void *dev_id)
+{
+	struct kwblk_req *req;
+	bool any = false;
+
+	while ((req = wasm_driver_block_reap())) {
+		blk_mq_end_request(blk_mq_rq_from_pdu(req),
+				   errno_to_blk_status(req->status));
+		any = true;
+	}
+	return any ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static const struct blk_mq_ops kwblk_mq_ops = {
+	.queue_rq	= kwblk_queue_rq,
+};
+
+static const struct block_device_operations kwblk_fops = {
+	.owner		= THIS_MODULE,
+};
+
+static int __init kwblk_add(u32 index, const struct kwblk_info *info)
+{
+	struct queue_limits lim = {
+		.max_hw_sectors		= 1024,		/* 512 KiB */
+		.max_segments		= KWBLK_MAX_SEGS,
+		.logical_block_size	= info->block_size ?: SECTOR_SIZE,
+	};
+	struct kwblk_dev *kd;
+	int err;
+
+	kd = kzalloc(sizeof(*kd), GFP_KERNEL);
+	if (!kd)
+		return -ENOMEM;
+	kd->index = index;
+	kd->info = *info;
+
+	if (info->flags & KWBLK_F_FLUSH)
+		lim.features |= BLK_FEAT_WRITE_CACHE;
+	if (info->flags & KWBLK_F_DISCARD) {
+		lim.max_hw_discard_sectors = UINT_MAX >> SECTOR_SHIFT;
+		lim.discard_granularity = PAGE_SIZE;
+	}
+	if (info->flags & KWBLK_F_WRITE_ZEROES)
+		lim.max_write_zeroes_sectors = UINT_MAX >> SECTOR_SHIFT;
+
+	kd->tag_set.ops = &kwblk_mq_ops;
+	kd->tag_set.nr_hw_queues = 1;
+	kd->tag_set.nr_maps = 1;
+	kd->tag_set.queue_depth = KWBLK_QUEUE_DEPTH;
+	kd->tag_set.numa_node = NUMA_NO_NODE;
+	kd->tag_set.cmd_size = sizeof(struct kwblk_req);
+	kd->tag_set.driver_data = kd;
+	err = blk_mq_alloc_tag_set(&kd->tag_set);
+	if (err)
+		goto out_free;
+
+	kd->disk = blk_mq_alloc_disk(&kd->tag_set, &lim, kd);
+	if (IS_ERR(kd->disk)) {
+		err = PTR_ERR(kd->disk);
+		goto out_tags;
+	}
+	kd->disk->major = kwblk_major;
+	kd->disk->first_minor = index * KWBLK_MINORS;
+	kd->disk->minors = KWBLK_MINORS;
+	kd->disk->fops = &kwblk_fops;
+	kd->disk->private_data = kd;
+	snprintf(kd->disk->disk_name, DISK_NAME_LEN, "wd%c", 'a' + index);
+	set_capacity(kd->disk, info->size >> SECTOR_SHIFT);
+	if (info->flags & KWBLK_F_RO)
+		set_disk_ro(kd->disk, true);
+
+	err = add_disk(kd->disk);
+	if (err)
+		goto out_disk;
+
+	pr_info("kwblk: %s: %llu MiB%s%s%s\n", kd->disk->disk_name,
+		info->size >> 20, info->flags & KWBLK_F_RO ? ", ro" : "",
+		info->flags & KWBLK_F_FLUSH ? ", flush" : "",
+		info->flags & KWBLK_F_DISCARD ? ", discard" : "");
+	return 0;
+
+out_disk:
+	put_disk(kd->disk);
+out_tags:
+	blk_mq_free_tag_set(&kd->tag_set);
+out_free:
+	kfree(kd);
+	return err;
+}
+
+static int __init kwblk_init(void)
+{
+	struct kwblk_info info;
+	u32 i;
+	int err;
+
+	kwblk_major = register_blkdev(0, "kwblk");
+	if (kwblk_major < 0)
+		return kwblk_major;
+
+	err = request_irq(WASM_IRQ_BLOCK, kwblk_irq, 0, "kwblk", NULL);
+	if (err) {
+		unregister_blkdev(kwblk_major, "kwblk");
+		return err;
+	}
+
+	for (i = 0; i < KWBLK_MAX_DEVS; i++) {
+		memset(&info, 0, sizeof(info));
+		if (wasm_driver_block_info(i, &info) < 0)
+			break;
+		if (!info.size)
+			continue;
+		if (!kwblk_add(i, &info))
+			kwblk_ndevs++;
+	}
+	return 0;
+}
+device_initcall(kwblk_init);
-- 
2.56.0

