 static int kjournald2(void *arg)
 {
 	journal_t *journal = arg;
-	transaction_t *transaction;
 
 	/*
 	 * Set up an interval timer which can be used to trigger a commit wakeup
@@ -181,15 +183,30 @@ static int kjournald2(void *arg)
 	 */
 	memalloc_nofs_save();
 
