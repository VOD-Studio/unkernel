+/*
+ * Wait forever for commit wakeup events. The thread also resumes here
+ * after parking (kw_park.h), past its setup.
+ */
+static int kjournald2_loop(void *arg)
+{
+	journal_t *journal = arg;
+	transaction_t *transaction;
+
 	write_lock(&journal->j_state_lock);
 
 loop:
 	if (journal->j_flags & JBD2_UNMOUNT)
 		goto end_loop;
 
+	if (kw_park_pending()) {
+		write_unlock(&journal->j_state_lock);
+		kw_park_point(kjournald2_loop, journal);
+		write_lock(&journal->j_state_lock);
+	}
+
 	jbd2_debug(1, "commit_sequence=%u, commit_request=%u\n",
 		journal->j_commit_sequence, journal->j_commit_request);
 
diff --git a/include/linux/kw_park.h b/include/linux/kw_park.h
new file mode 100644
index 000000000..d5e71f700
--- /dev/null
+++ b/include/linux/kw_park.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Park points (CONFIG_KW_PARK).
+ *
+ * arch/wasm cannot save a sleeping task's stack: each kernel task runs on
+ * its own stack in the host engine, outside guest memory. To make the whole
+ * machine state live in memory (for a snapshot, or to move a task), it
+ * parks every task at a point where nothing on its stack is needed again,
+ * and later resumes it on a fresh stack. User tasks park at the user-mode
+ * boundary. A kernel thread parks at a kw_park_point() in its main loop,
+ * placed where it holds no locks and has nothing on its stack linked into
+ * shared structures (no wait queue entry, no on-stack timer), and resumes
+ * by calling fn(arg), which re-enters that loop without redoing one-time
+ * setup.
+ *
+ * Kernel threads without a park point keep a snapshot from completing.
+ */
+#ifndef _LINUX_KW_PARK_H
+#define _LINUX_KW_PARK_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+#ifdef CONFIG_KW_PARK
+extern int kw_park_kthreads;
+
+void kw_park_kthread(int (*fn)(void *), void *arg);
+
+/*
+ * True while kernel threads are asked to park. Wait conditions that a
+ * plain wake_up_process() does not end (wait_event*()) add it, so that the
+ * thread gets back to its park point.
+ */
+static inline bool kw_park_pending(void)
+{
+	return unlikely(READ_ONCE(kw_park_kthreads));
+}
+
+/*
+ * Park here if asked to. The thread then never returns from this call: it
+ * resumes on a fresh stack in fn(arg), whose return value is its exit code
+ * as for a kthread function.
+ */
+static inline void kw_park_point(int (*fn)(void *), void *arg)
+{
+	if (kw_park_pending())
+		kw_park_kthread(fn, arg);
+}
+#else
+static inline bool kw_park_pending(void)
+{
+	return false;
+}
+
+static inline void kw_park_point(int (*fn)(void *), void *arg)
+{
+}
+#endif
+
+#endif /* _LINUX_KW_PARK_H */
