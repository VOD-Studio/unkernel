+/* kthreadd's loop; it also resumes here after parking (kw_park.h). */
+static int kthreadd_loop(void *unused)
+{
 	for (;;) {
+		kw_park_point(kthreadd_loop, NULL);
 		set_current_state(TASK_INTERRUPTIBLE);
 		if (list_empty(&kthread_create_list))
 			schedule();
@@ -998,6 +1008,7 @@ int kthread_worker_fn(void *worker_ptr)
 		set_freezable();
 
 repeat:
+	kw_park_point(kthread_worker_fn, worker_ptr);
 	set_current_state(TASK_INTERRUPTIBLE);	/* mb paired w/ kthread_stop */
 
 	if (kthread_should_stop()) {
