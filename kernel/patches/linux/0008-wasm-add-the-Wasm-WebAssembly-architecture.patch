diff --git a/arch/wasm/include/asm/pgalloc.h b/arch/wasm/include/asm/pgalloc.h
new file mode 100644
index 000000000..888fb4f25
--- /dev/null
+++ b/arch/wasm/include/asm/pgalloc.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_PGALLOC_H
+#define _ASM_WASM_PGALLOC_H
+
+#include <linux/mm.h>
+#include <asm/tlb.h>
+
+#include <asm-generic/pgalloc.h>
+
+static inline void pmd_populate_kernel(struct mm_struct *mm, pmd_t *pmd,
+				       pte_t *pte)
+{
+	set_pmd(pmd, __pmd((virt_to_pfn(pte) << _PAGE_PFN_SHIFT) | _PAGE_TABLE));
+}
+
+static inline void pmd_populate(struct mm_struct *mm, pmd_t *pmd,
+				pgtable_t pte)
+{
+	set_pmd(pmd, __pmd((page_to_pfn(pte) << _PAGE_PFN_SHIFT) | _PAGE_TABLE));
+}
+
+static inline void pud_populate(struct mm_struct *mm, pud_t *pud, pmd_t *pmd)
+{
+	set_pud(pud, __pud((virt_to_pfn(pmd) << _PAGE_PFN_SHIFT) | _PAGE_TABLE));
+}
+
+extern pgd_t *pgd_alloc(struct mm_struct *mm);
+
+#define __pte_free_tlb(tlb, pte, address) \
+	tlb_remove_ptdesc((tlb), page_ptdesc(pte))
+#define __pmd_free_tlb(tlb, pmd, address) \
+	tlb_remove_ptdesc((tlb), virt_to_ptdesc(pmd))
+
+#endif /* _ASM_WASM_PGALLOC_H */
diff --git a/arch/wasm/include/asm/pgtable.h b/arch/wasm/include/asm/pgtable.h
new file mode 100644
index 000000000..78f4b6ab5
--- /dev/null
+++ b/arch/wasm/include/asm/pgtable.h
@@ -0,0 +1,419 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_PGTABLE_H
+#define _ASM_WASM_PGTABLE_H
+
+/*
+ * User page tables in RISC-V Sv39 format (3 levels, 4 KiB pages, 512 x 8-byte
+ * entries per level). They are walked in software by the kwemu CPU (see
+ * kw_emu.h) and by the uaccess code. Physical address == linear address
+ * (kw_cpu.phys_base == 0). Kernel memory is never mapped by these tables.
+ */
+
+#include <asm-generic/pgtable-nopud.h>
+
+#include <linux/const.h>
+#include <linux/bits.h>
+#include <asm/page.h>
+#include <asm/processor.h>
+
+#define PGDIR_SHIFT	30
+#define PGDIR_SIZE	(_AC(1, UL) << PGDIR_SHIFT)
+#define PGDIR_MASK	(~(PGDIR_SIZE - 1))
+
+#define PMD_SHIFT	21
+#define PMD_SIZE	(_AC(1, UL) << PMD_SHIFT)
+#define PMD_MASK	(~(PMD_SIZE - 1))
+
+#define PTRS_PER_PGD	512
+#define PTRS_PER_PMD	512
+#define PTRS_PER_PTE	512
+
+#define USER_PTRS_PER_PGD	(TASK_SIZE / PGDIR_SIZE)
+#define FIRST_USER_ADDRESS	0UL
+
+/* Sv39 PTE bits (identical to arch/riscv/include/asm/pgtable-bits.h). */
+#define _PAGE_PRESENT	(1UL << 0)	/* V */
+#define _PAGE_READ	(1UL << 1)
+#define _PAGE_WRITE	(1UL << 2)
+#define _PAGE_EXEC	(1UL << 3)
+#define _PAGE_USER	(1UL << 4)
+#define _PAGE_GLOBAL	(1UL << 5)
+#define _PAGE_ACCESSED	(1UL << 6)
+#define _PAGE_DIRTY	(1UL << 7)
+#define _PAGE_SOFT	(3UL << 8)
+#define _PAGE_SPECIAL	(1UL << 8)
+
+#define _PAGE_TABLE	_PAGE_PRESENT
+/* V=0 with G=1: a PROT_NONE mapping (present for Linux, invalid for kwemu). */
+#define _PAGE_PROT_NONE	_PAGE_GLOBAL
+#define _PAGE_SWP_EXCLUSIVE _PAGE_ACCESSED
+#define _PAGE_LEAF	(_PAGE_READ | _PAGE_WRITE | _PAGE_EXEC)
+
+#define _PAGE_PFN_SHIFT	10
+#define _PAGE_PFN_MASK	GENMASK(53, 10)
+
+/* Bits preserved by pte_modify(). */
+#define _PAGE_CHG_MASK	(_PAGE_PFN_MASK | _PAGE_ACCESSED | _PAGE_DIRTY | \
+			 _PAGE_SPECIAL)
+
+#define _PAGE_BASE	(_PAGE_PRESENT | _PAGE_ACCESSED | _PAGE_USER)
+
+#define PAGE_NONE		__pgprot(_PAGE_PROT_NONE | _PAGE_READ)
+#define PAGE_READ		__pgprot(_PAGE_BASE | _PAGE_READ)
+#define PAGE_WRITE		__pgprot(_PAGE_BASE | _PAGE_READ | _PAGE_WRITE)
+#define PAGE_EXEC		__pgprot(_PAGE_BASE | _PAGE_EXEC)
+#define PAGE_READ_EXEC		__pgprot(_PAGE_BASE | _PAGE_READ | _PAGE_EXEC)
+#define PAGE_WRITE_EXEC		__pgprot(_PAGE_BASE | _PAGE_READ | \
+					 _PAGE_EXEC | _PAGE_WRITE)
+#define PAGE_COPY		PAGE_READ
+#define PAGE_COPY_EXEC		PAGE_READ_EXEC
+#define PAGE_SHARED		PAGE_WRITE
+#define PAGE_SHARED_EXEC	PAGE_WRITE_EXEC
+#define PAGE_READONLY		PAGE_READ
+
+#define _PAGE_KERNEL	(_PAGE_READ | _PAGE_WRITE | _PAGE_PRESENT | \
+			 _PAGE_ACCESSED | _PAGE_DIRTY | _PAGE_GLOBAL)
+#define PAGE_KERNEL		__pgprot(_PAGE_KERNEL)
+#define PAGE_KERNEL_EXEC	__pgprot(_PAGE_KERNEL | _PAGE_EXEC)
+#define PAGE_KERNEL_RO		__pgprot(_PAGE_KERNEL & ~_PAGE_WRITE)
+#define PAGE_TABLE		__pgprot(_PAGE_TABLE)
+
+/*
+ * There is no vmalloc area that can alias pages: vmalloc() returns direct
+ * mapped memory (see mm/vmalloc-flat.c). Keep the range empty.
+ */
+#define VMALLOC_START	0UL
+#define VMALLOC_END	0UL
+
+#ifndef __ASSEMBLER__
+
+#include <linux/mm_types.h>
+
+extern pgd_t swapper_pg_dir[PTRS_PER_PGD];
+extern void paging_init(void);
+
+/* --- conversions ------------------------------------------------------ */
+
+static inline unsigned long __page_val_to_pfn(unsigned long val)
+{
+	return (val & _PAGE_PFN_MASK) >> _PAGE_PFN_SHIFT;
+}
+
+static inline pte_t pfn_pte(unsigned long pfn, pgprot_t prot)
+{
+	return __pte((pfn << _PAGE_PFN_SHIFT) | pgprot_val(prot));
+}
+
+static inline unsigned long pte_pfn(pte_t pte)
+{
+	return __page_val_to_pfn(pte_val(pte));
+}
+
+#define pte_page(x)	pfn_to_page(pte_pfn(x))
+#define PFN_PTE_SHIFT	_PAGE_PFN_SHIFT
+
+static inline unsigned long pmd_pfn(pmd_t pmd)
+{
+	return __page_val_to_pfn(pmd_val(pmd));
+}
+
+static inline pmd_t pfn_pmd(unsigned long pfn, pgprot_t prot)
+{
+	return __pmd((pfn << _PAGE_PFN_SHIFT) | pgprot_val(prot));
+}
+
+#define pmd_page(pmd)	pfn_to_page(pmd_pfn(pmd))
+
+static inline unsigned long pmd_page_vaddr(pmd_t pmd)
+{
+	return (unsigned long)pfn_to_virt(pmd_pfn(pmd));
+}
+
+static inline pte_t pmd_pte(pmd_t pmd)
+{
+	return __pte(pmd_val(pmd));
+}
+
+static inline pmd_t pte_pmd(pte_t pte)
+{
+	return __pmd(pte_val(pte));
+}
+
+/* --- PMD level -------------------------------------------------------- */
+
+static inline int pmd_present(pmd_t pmd)
+{
+	return pmd_val(pmd) & (_PAGE_PRESENT | _PAGE_PROT_NONE);
+}
+
+static inline int pmd_none(pmd_t pmd)
+{
+	return pmd_val(pmd) == 0;
+}
+
+static inline int pmd_bad(pmd_t pmd)
+{
+	return !pmd_present(pmd) || (pmd_val(pmd) & _PAGE_LEAF);
+}
+
+#define pmd_leaf(pmd)	false
+
+static inline void set_pmd(pmd_t *pmdp, pmd_t pmd)
+{
+	WRITE_ONCE(*pmdp, pmd);
+}
+
+static inline void pmd_clear(pmd_t *pmdp)
+{
+	set_pmd(pmdp, __pmd(0));
+}
+
+/* --- PGD level (holds PMD tables; PUD/P4D folded) --------------------- */
+
+static inline int pud_present(pud_t pud)
+{
+	return pud_val(pud) & _PAGE_PRESENT;
+}
+
+static inline int pud_none(pud_t pud)
+{
+	return pud_val(pud) == 0;
+}
+
+static inline int pud_bad(pud_t pud)
+{
+	return !pud_present(pud) || (pud_val(pud) & _PAGE_LEAF);
+}
+
+#define pud_leaf(pud)	false
+
+static inline void set_pud(pud_t *pudp, pud_t pud)
+{
+	WRITE_ONCE(*pudp, pud);
+}
+
+static inline void pud_clear(pud_t *pudp)
+{
+	set_pud(pudp, __pud(0));
+}
+
+static inline unsigned long pud_pfn(pud_t pud)
+{
+	return __page_val_to_pfn(pud_val(pud));
+}
+
+static inline pmd_t *pud_pgtable(pud_t pud)
+{
+	return (pmd_t *)pfn_to_virt(pud_pfn(pud));
+}
+
+#define pud_page(pud)	pfn_to_page(pud_pfn(pud))
+
+/* --- PTE level -------------------------------------------------------- */
+
+static inline int pte_present(pte_t pte)
+{
+	return pte_val(pte) & (_PAGE_PRESENT | _PAGE_PROT_NONE);
+}
+
+#define pte_accessible(mm, pte) \
+	(pte_val(pte) & _PAGE_PRESENT)
+
+static inline int pte_none(pte_t pte)
+{
+	return pte_val(pte) == 0;
+}
+
+static inline int pte_read(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_READ;
+}
+
+static inline int pte_write(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_WRITE;
+}
+
+static inline int pte_exec(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_EXEC;
+}
+
+static inline int pte_user(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_USER;
+}
+
+static inline int pte_huge(pte_t pte)
+{
+	return 0;
+}
+
+static inline int pte_dirty(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_DIRTY;
+}
+
+static inline int pte_young(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_ACCESSED;
+}
+
+static inline int pte_special(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_SPECIAL;
+}
+
+static inline pte_t pte_wrprotect(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PAGE_WRITE);
+}
+
+static inline pte_t pte_mkwrite_novma(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PAGE_WRITE);
+}
+
+static inline pte_t pte_mkdirty(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PAGE_DIRTY);
+}
+
+static inline pte_t pte_mkclean(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PAGE_DIRTY);
+}
+
+static inline pte_t pte_mkyoung(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PAGE_ACCESSED);
+}
+
+static inline pte_t pte_mkold(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PAGE_ACCESSED);
+}
+
+static inline pte_t pte_mkspecial(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PAGE_SPECIAL);
+}
+
+static inline pte_t pte_mkhuge(pte_t pte)
+{
+	return pte;
+}
+
+static inline pte_t pte_modify(pte_t pte, pgprot_t newprot)
+{
+	return __pte((pte_val(pte) & _PAGE_CHG_MASK) | pgprot_val(newprot));
+}
+
+#define pgprot_noncached(prot)		(prot)
+#define pgprot_writecombine(prot)	(prot)
+
+/*
+ * PTE updates. The emulator caches translations, so every change that may
+ * shrink permissions is followed by a flush_tlb_*() from the generic code;
+ * changes that grow permissions go through update_mmu_cache_range().
+ */
+static inline void set_pte(pte_t *ptep, pte_t pte)
+{
+	WRITE_ONCE(*ptep, pte);
+}
+
+#define set_ptes set_ptes
+static inline void set_ptes(struct mm_struct *mm, unsigned long addr,
+			    pte_t *ptep, pte_t pte, unsigned int nr)
+{
+	for (;;) {
+		set_pte(ptep, pte);
+		if (--nr == 0)
+			break;
+		ptep++;
+		pte = __pte(pte_val(pte) + (1UL << _PAGE_PFN_SHIFT));
+	}
+}
+
+static inline void pte_clear(struct mm_struct *mm, unsigned long addr,
+			     pte_t *ptep)
+{
+	set_pte(ptep, __pte(0));
+}
+
+struct vm_fault;
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long addr, pte_t *ptep, unsigned int nr);
+#define update_mmu_cache(vma, addr, ptep) \
+	update_mmu_cache_range(NULL, vma, addr, ptep, 1)
+
+#define __HAVE_ARCH_PTEP_GET_AND_CLEAR
+static inline pte_t ptep_get_and_clear(struct mm_struct *mm,
+				       unsigned long address, pte_t *ptep)
+{
+	pte_t pte = *ptep;
+
+	set_pte(ptep, __pte(0));
+	return pte;
+}
+
+#define __HAVE_ARCH_PTEP_SET_WRPROTECT
+static inline void ptep_set_wrprotect(struct mm_struct *mm,
+				      unsigned long address, pte_t *ptep)
+{
+	set_pte(ptep, pte_wrprotect(*ptep));
+}
+
+/* --- swap entries (riscv layout) --------------------------------------- */
+/*
+ *	bit            0:	_PAGE_PRESENT (zero)
+ *	bit       1 to 5:	(zero; bit 5 is _PAGE_PROT_NONE)
+ *	bit            6:	exclusive marker
+ *	bits      7 to 11:	swap type
+ *	bits 12 to XLEN-1:	swap offset
+ */
+#define __SWP_TYPE_SHIFT	7
+#define __SWP_TYPE_BITS		5
+#define __SWP_TYPE_MASK		((1UL << __SWP_TYPE_BITS) - 1)
+#define __SWP_OFFSET_SHIFT	(__SWP_TYPE_BITS + __SWP_TYPE_SHIFT)
+
+#define MAX_SWAPFILES_CHECK()	\
+	BUILD_BUG_ON(MAX_SWAPFILES_SHIFT > __SWP_TYPE_BITS)
+
+#define __swp_type(x)	(((x).val >> __SWP_TYPE_SHIFT) & __SWP_TYPE_MASK)
+#define __swp_offset(x)	((x).val >> __SWP_OFFSET_SHIFT)
+#define __swp_entry(type, offset) ((swp_entry_t) \
+	{ (((type) & __SWP_TYPE_MASK) << __SWP_TYPE_SHIFT) | \
+	  ((offset) << __SWP_OFFSET_SHIFT) })
+
+#define __pte_to_swp_entry(pte)	((swp_entry_t) { pte_val(pte) })
+#define __swp_entry_to_pte(x)	((pte_t) { (x).val })
+
+static inline bool pte_swp_exclusive(pte_t pte)
+{
+	return pte_val(pte) & _PAGE_SWP_EXCLUSIVE;
+}
+
+static inline pte_t pte_swp_mkexclusive(pte_t pte)
+{
+	return __pte(pte_val(pte) | _PAGE_SWP_EXCLUSIVE);
+}
+
+static inline pte_t pte_swp_clear_exclusive(pte_t pte)
+{
+	return __pte(pte_val(pte) & ~_PAGE_SWP_EXCLUSIVE);
+}
+
+#define pte_ERROR(e) \
+	pr_err("%s:%d: bad pte %016lx.\n", __FILE__, __LINE__, pte_val(e))
+#define pmd_ERROR(e) \
+	pr_err("%s:%d: bad pmd %016lx.\n", __FILE__, __LINE__, pmd_val(e))
+#define pgd_ERROR(e) \
+	pr_err("%s:%d: bad pgd %016lx.\n", __FILE__, __LINE__, pgd_val(e))
+
+#define kern_addr_valid(addr)	(1)
+
+#endif /* !__ASSEMBLER__ */
+
+#endif /* _ASM_WASM_PGTABLE_H */
diff --git a/arch/wasm/include/asm/processor.h b/arch/wasm/include/asm/processor.h
new file mode 100644
index 000000000..648e1c367
--- /dev/null
+++ b/arch/wasm/include/asm/processor.h
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_PROCESSOR_H
+#define _ASM_WASM_PROCESSOR_H
+
+#include <linux/const.h>
+
+/* Calling C code requires the stack to be 16-byte alignment (LLVM mandated). */
+#define STACK_ALIGN 16
+
+/*
+ * User address space: Sv39 lower half, as on riscv64 (256 GiB). User and
+ * kernel addresses overlap numerically; they are different address spaces
+ * (user memory is only reachable through page-table walks).
+ */
+#define TASK_SIZE		(_AC(1, UL) << 38)
+#define TASK_SIZE_MAX		TASK_SIZE
+#define DEFAULT_MAP_WINDOW	TASK_SIZE
+#define STACK_TOP		TASK_SIZE
+#define STACK_TOP_MAX		TASK_SIZE
+#define TASK_UNMAPPED_BASE	PAGE_ALIGN(TASK_SIZE / 3)
+
+#ifndef __ASSEMBLER__
+
+struct task_struct;
+struct pt_regs;
+
+#define cpu_relax()	barrier()
+
+struct thread_struct {
+	int (*fn)(void *);	/* kernel thread entry (until first run) */
+	void *fn_arg;
+};
+
+#define INIT_THREAD { }
+
+__visible unsigned long wasm_memory_size(void);
+__visible unsigned long wasm_memory_grow(unsigned long delta_pages);
+
+void start_thread(struct pt_regs *regs, unsigned long pc, unsigned long sp);
+
+static inline unsigned long __get_wchan(struct task_struct *p)
+{
+	return 0;
+}
+
+#define task_pt_regs(task) \
+	((struct pt_regs *)(task_stack_page(task) + THREAD_SIZE) - 1)
+
+#define KSTK_EIP(tsk)	(task_pt_regs(tsk)->user.pc)
+#define KSTK_ESP(tsk)	(task_pt_regs(tsk)->user.x[2])
+
+#endif /* __ASSEMBLER__ */
+
+#endif /* _ASM_WASM_PROCESSOR_H */
diff --git a/arch/wasm/include/asm/ptrace.h b/arch/wasm/include/asm/ptrace.h
new file mode 100644
index 000000000..d905f6c9f
--- /dev/null
+++ b/arch/wasm/include/asm/ptrace.h
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_PTRACE_H
+#define _ASM_WASM_PTRACE_H
+
+#include <uapi/asm/ptrace.h>
+
+#define PTRACE_SYSEMU			0x1f
+#define PTRACE_SYSEMU_SINGLESTEP	0x20
+
+#ifndef __ASSEMBLER__
+
+#include <asm/kw_emu.h>
+
+/*
+ * Kernel entry frame. For user tasks it sits at the top of the kernel stack
+ * and holds the riscv64 user context run by kwemu. Frames for interrupts
+ * taken while in the kernel (idle) are built on the stack with kernel=1.
+ */
+struct pt_regs {
+	struct kw_regs user;	/* x0..x31, pc, f0..f31, fcsr */
+	unsigned long orig_a0;
+	unsigned long cause;	/* PT_CAUSE_* */
+	unsigned long badaddr;
+	unsigned long kernel;	/* non-zero: frame interrupted kernel code */
+	unsigned long irqflags;	/* irq state at entry (kernel frames) */
+};
+
+#define PT_CAUSE_NONE		(-1UL)
+#define PT_CAUSE_SYSCALL	8UL	/* like riscv EXC_SYSCALL */
+
+/* Register accessors (riscv ABI names). */
+#define REG_RA	1
+#define REG_SP	2
+#define REG_GP	3
+#define REG_TP	4
+#define REG_A0	10
+#define REG_A7	17
+
+#define user_mode(regs)			(!(regs)->kernel)
+#define instruction_pointer(regs)	((regs)->user.pc)
+#define user_stack_pointer(regs)	((regs)->user.x[REG_SP])
+#define profile_pc(regs)		instruction_pointer(regs)
+
+static inline void instruction_pointer_set(struct pt_regs *regs,
+					   unsigned long val)
+{
+	regs->user.pc = val;
+}
+
+static inline unsigned long regs_return_value(struct pt_regs *regs)
+{
+	return regs->user.x[REG_A0];
+}
+
+static inline void regs_set_return_value(struct pt_regs *regs,
+					 unsigned long val)
+{
+	regs->user.x[REG_A0] = val;
+}
+
+#define current_pt_regs()		task_pt_regs(current)
+#define current_user_stack_pointer()	user_stack_pointer(current_pt_regs())
+
+static inline int regs_irqs_disabled(struct pt_regs *regs)
+{
+	return regs->kernel && !regs->irqflags;
+}
+
+#endif /* !__ASSEMBLER__ */
+
+#endif /* _ASM_WASM_PTRACE_H */
