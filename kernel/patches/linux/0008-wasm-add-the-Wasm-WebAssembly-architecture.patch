diff --git a/arch/wasm/include/asm/futex.h b/arch/wasm/include/asm/futex.h
new file mode 100644
index 000000000..298606ab1
--- /dev/null
+++ b/arch/wasm/include/asm/futex.h
@@ -0,0 +1,66 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_FUTEX_H
+#define _ASM_WASM_FUTEX_H
+
+#include <linux/futex.h>
+#include <linux/uaccess.h>
+#include <asm/errno.h>
+
+/*
+ * Single CPU, no preemption, and user mode only runs when the kernel calls
+ * kw_run(): plain read-modify-write on the translated address is atomic.
+ */
+static inline int futex_atomic_cmpxchg_inatomic(u32 *uval, u32 __user *uaddr,
+						u32 oldval, u32 newval)
+{
+	u32 *p;
+
+	if (!access_ok(uaddr, sizeof(u32)))
+		return -EFAULT;
+	p = kw_user_addr(uaddr, sizeof(u32), true);
+	if (!p)
+		return -EFAULT;
+
+	*uval = *p;
+	if (*uval == oldval)
+		*p = newval;
+	return 0;
+}
+
+static inline int arch_futex_atomic_op_inuser(int op, u32 oparg, int *oval,
+					      u32 __user *uaddr)
+{
+	u32 *p, old;
+
+	if (!access_ok(uaddr, sizeof(u32)))
+		return -EFAULT;
+	p = kw_user_addr(uaddr, sizeof(u32), true);
+	if (!p)
+		return -EFAULT;
+
+	old = *p;
+	switch (op) {
+	case FUTEX_OP_SET:
+		*p = oparg;
+		break;
+	case FUTEX_OP_ADD:
+		*p = old + oparg;
+		break;
+	case FUTEX_OP_OR:
+		*p = old | oparg;
+		break;
+	case FUTEX_OP_ANDN:
+		*p = old & ~oparg;
+		break;
+	case FUTEX_OP_XOR:
+		*p = old ^ oparg;
+		break;
+	default:
+		return -ENOSYS;
+	}
+	*oval = old;
+	return 0;
+}
+
+#endif /* _ASM_WASM_FUTEX_H */
