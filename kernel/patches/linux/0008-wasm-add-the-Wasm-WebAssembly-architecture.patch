diff --git a/arch/wasm/include/asm/page.h b/arch/wasm/include/asm/page.h
new file mode 100644
index 000000000..3ea450a5c
--- /dev/null
+++ b/arch/wasm/include/asm/page.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_PAGE_H
+#define _ASM_WASM_PAGE_H
+
+/* PAGE_SHIFT, PAGE_SIZE, ... derived from CONFIG_PAGE_SHIFT. */
+#include <vdso/page.h>
+
+#include <asm/setup.h>
+
+/*
+ * Memory model: the kernel lives in Wasm linear memory and only ever uses the
+ * "direct map": kernel virtual address == physical address == linear memory
+ * address. There is no hardware MMU and no way to alias memory, so kernel
+ * page tables are never consulted. User address spaces exist only in the
+ * (Sv39-format) page tables walked by the kwemu software CPU and by the
+ * uaccess routines (see arch/wasm/mm/uaccess.c).
+ */
+#define WASM_PAGE_SHIFT		16
+#define WASM_PAGE_SIZE		(1UL << WASM_PAGE_SHIFT)
+
+#define PAGE_OFFSET		(0UL)
+#define ARCH_PFN_OFFSET		(0UL)
+
+#ifndef __ASSEMBLER__
+
+#define clear_page(page)	memset((page), 0, PAGE_SIZE)
+#define copy_page(to, from)	memcpy((to), (from), PAGE_SIZE)
+
+/*
+ * No clear_user_page(): the generic one in <linux/highmem.h> is clear_page(),
+ * and without it clear_user_pages() uses clear_pages().
+ */
+#define copy_user_page(to, from, vaddr, pg)	copy_page(to, from)
+
+typedef struct { unsigned long pte; } pte_t;
+typedef struct { unsigned long pmd; } pmd_t;
+typedef struct { unsigned long pgd; } pgd_t;
+typedef struct { unsigned long pgprot; } pgprot_t;
+typedef struct page *pgtable_t;
+
+#define pte_val(x)	((x).pte)
+#define pmd_val(x)	((x).pmd)
+#define pgd_val(x)	((x).pgd)
+#define pgprot_val(x)	((x).pgprot)
+
+#define __pte(x)	((pte_t) { (x) })
+#define __pmd(x)	((pmd_t) { (x) })
+#define __pgd(x)	((pgd_t) { (x) })
+#define __pgprot(x)	((pgprot_t) { (x) })
+
+#define __va(x)		((void *)((unsigned long)(x)))
+#define __pa(x)		((unsigned long)(x))
+#define __pa_symbol(x)	__pa(x)
+#define phys_to_virt(x)	__va(x)
+#define virt_to_phys(x)	__pa(x)
+
+#define virt_to_pfn(kaddr)	(__pa(kaddr) >> PAGE_SHIFT)
+#define pfn_to_virt(pfn)	__va((unsigned long)(pfn) << PAGE_SHIFT)
+
+#define virt_to_page(addr)	pfn_to_page(virt_to_pfn(addr))
+#define page_to_virt(page)	pfn_to_virt(page_to_pfn(page))
+
+extern unsigned long memory_start;
+extern unsigned long memory_end;
+
+#define virt_addr_valid(kaddr)	((unsigned long)(kaddr) >= memory_start && \
+				 (unsigned long)(kaddr) < memory_end)
+
+#include <asm-generic/memory_model.h>
+#include <asm-generic/getorder.h>
+
+#endif /* !__ASSEMBLER__ */
+
+#endif /* _ASM_WASM_PAGE_H */
