+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <linux/delay.h>
+#include <linux/export.h>
+#include <asm/wasm.h>
+
+void calibrate_delay(void)
+{
+	/* Wasm convention: lpj = nanoseconds per jiffy */
+	loops_per_jiffy = 1000000000 / HZ;
+}
+
+void __delay(unsigned long ns)
+{
+	unsigned long long end = wasm_cpu_clock_get_monotonic() + ns;
+
+	while (wasm_cpu_clock_get_monotonic() < end)
+		barrier();
+}
+EXPORT_SYMBOL(__delay);
diff --git a/arch/wasm/lib/multi3.c b/arch/wasm/lib/multi3.c
new file mode 100644
index 000000000..1b842755e
--- /dev/null
+++ b/arch/wasm/lib/multi3.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <linux/export.h>
+#include <linux/types.h>
+
+/* Wasm has no i128 but LLVM supports it as 2x i64, normally via compiler-rt. */
+__visible u128 __multi3(u128 a, u128 b);
+__visible u128 __multi3(u128 a, u128 b)
+{
+    u128 aa = a;
+    u128 bb = b;
+    u128 acc = 0;
+
+    /* TODO: This could be made much more efficiently with u64:s... */
+    while (aa) {
+        if (aa & 1) {
+            acc += bb;
+        }
+        aa >>= 1;
+        bb <<= 1;
+    }
+
+    return acc;
+}
+EXPORT_SYMBOL(__multi3);
