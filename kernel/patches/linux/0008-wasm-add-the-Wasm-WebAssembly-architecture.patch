diff --git a/arch/wasm/kernel/process.c b/arch/wasm/kernel/process.c
new file mode 100644
index 000000000..d0ea9b5ac
--- /dev/null
+++ b/arch/wasm/kernel/process.c
@@ -0,0 +1,127 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Tasks and context switching.
+ *
+ * Every kernel task runs on its own Wasm stack. __switch_to() calls the host
+ * (wasm_switch_to, a JSPI suspending import) which suspends the current stack
+ * and resumes the next task's suspended stack, or starts a new one through
+ * the ret_from_fork export. The kernel C stack (__stack_pointer) and
+ * `current` are Wasm globals, saved/restored around the switch in entry.S.
+ */
+
+#include <linux/entry-common.h>
+#include <linux/ptrace.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/printk.h>
+#include <linux/slab.h>
+#include <asm/entry.h>
+#include <asm/kw_emu.h>
+#include <asm/wasm.h>
+
+extern struct kw_cpu *const wasm_kw_cpu;
+
+struct task_struct *__sched
+__switch_to(struct task_struct *prev, struct task_struct *next)
+{
+	int is_new = 0;
+
+	if (task_thread_info(next)->flags & _TIF_NEVER_RUN) {
+		task_thread_info(next)->flags &= ~_TIF_NEVER_RUN;
+		is_new = 1;
+	}
+
+	/* Threads sharing an mm must not inherit an LR/SC reservation. */
+	kw_clear_reservation(wasm_kw_cpu);
+
+	return wasm_arch_switch(prev, next, is_new,
+				READ_ONCE(prev->__state) == TASK_DEAD);
+}
+
+/* Called from ret_from_fork (entry.S) on the new task's fresh Wasm stack. */
+asmlinkage void __ret_from_fork(struct task_struct *prev)
+{
+	struct pt_regs *regs = current_pt_regs();
+
+	schedule_tail(prev);
+
+	if (current->thread.fn) {
+		/* Kernel thread. Returns only after a successful kernel_execve(). */
+		current->thread.fn(current->thread.fn_arg);
+		current->thread.fn = NULL;
+	}
+
+	syscall_exit_to_user_mode(regs);
+	user_mode_loop(regs);
+}
+
+void flush_thread(void)
+{
+}
+
+int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
+{
+	struct pt_regs *childregs = task_pt_regs(p);
+
+	task_thread_info(p)->flags |= _TIF_NEVER_RUN;
+
+	if (unlikely(args->fn)) {
+		/* Kernel thread (or user worker). */
+		memset(childregs, 0, sizeof(*childregs));
+		p->thread.fn = args->fn;
+		p->thread.fn_arg = args->fn_arg;
+	} else {
+		*childregs = *current_pt_regs();
+		childregs->user.x[REG_A0] = 0; /* child returns 0 */
+		if (args->stack)
+			childregs->user.x[REG_SP] = args->stack;
+		if (args->flags & CLONE_SETTLS)
+			childregs->user.x[REG_TP] = args->tls;
+		p->thread.fn = NULL;
+		p->thread.fn_arg = NULL;
+	}
+	childregs->kernel = 0;
+	childregs->cause = PT_CAUSE_NONE;
+
+	return 0;
+}
+
+void start_thread(struct pt_regs *regs, unsigned long pc, unsigned long sp)
+{
+	memset(&regs->user, 0, sizeof(regs->user));
+	regs->user.pc = pc;
+	regs->user.x[REG_SP] = sp;
+	regs->kernel = 0;
+}
+
+void show_regs(struct pt_regs *regs)
+{
+	int i;
+
+	show_regs_print_info(KERN_DEFAULT);
+	pr_cont("pc: %016llx ra: %016llx sp: %016llx\n",
+		regs->user.pc, regs->user.x[1], regs->user.x[2]);
+	for (i = 3; i < 32; i += 3)
+		pr_cont(" x%-2d %016llx x%-2d %016llx x%-2d %016llx\n",
+			i, regs->user.x[i], i + 1,
+			i + 1 < 32 ? regs->user.x[i + 1] : 0ULL,
+			i + 2, i + 2 < 32 ? regs->user.x[i + 2] : 0ULL);
+}
+
+void show_stack(struct task_struct *task, unsigned long *stack,
+		const char *loglvl)
+{
+	char *stack_trace;
+
+	if (task && task != current)
+		return;
+
+	stack_trace = kmalloc(WASM_STACKTRACE_MAX_SIZE, GFP_ATOMIC);
+	if (stack_trace) {
+		wasm_dump_stacktrace(stack_trace, WASM_STACKTRACE_MAX_SIZE);
+		printk("%sCall trace (host):\n%s\n", loglvl, stack_trace);
+	}
+	kfree(stack_trace);
+}
