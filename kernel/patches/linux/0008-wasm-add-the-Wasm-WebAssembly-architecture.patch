diff --git a/drivers/tty/hvc/hvc_wasm.c b/drivers/tty/hvc/hvc_wasm.c
new file mode 100644
index 000000000..155b935ce
--- /dev/null
+++ b/drivers/tty/hvc/hvc_wasm.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <linux/interrupt.h>
+#include <linux/tty.h>
+#include <asm/irq.h>
+#include <asm/wasm.h>
+#include "hvc_console.h"
+
+static struct hvc_struct *hvc_wasm_hp;
+/* Last host window size (rows << 16 | cols) given to the tty; hp->lock. */
+static u32 hvc_wasm_size;
+
+static struct winsize hvc_wasm_winsize(u32 size)
+{
+	return (struct winsize){ .ws_row = size >> 16, .ws_col = size & 0xffff };
+}
+
+static ssize_t hvc_wasm_put_chars(uint32_t vtermno, const u8 *buf, size_t count)
+{
+	return wasm_console_write(buf, count);
+}
+
+/*
+ * Called by __hvc_poll() with hp->lock held and a tty attached. Besides
+ * reading input, pick up a new host window size: the host raises
+ * WASM_IRQ_CONSOLE after a resize, so this runs promptly, and __hvc_resize()
+ * updates the tty (and sends SIGWINCH) from a work item.
+ */
+static ssize_t hvc_wasm_get_chars(uint32_t vtermno, u8 *buf, size_t count)
+{
+	struct hvc_struct *hp = hvc_wasm_hp;
+	u32 size;
+
+	if (hp) {
+		size = wasm_driver_console_size();
+		if (size && size != hvc_wasm_size) {
+			hvc_wasm_size = size;
+			__hvc_resize(hp, hvc_wasm_winsize(size));
+		}
+	}
+	return wasm_console_read(buf, count);
+}
+
+/*
+ * First open of the tty (from hvc_open(), may sleep). A new tty starts at
+ * 0x0, so set the host size before the opener can ask for it. Returning 0
+ * leaves hp->irq_requested clear: khvcd keeps polling.
+ */
+static int hvc_wasm_notifier_add(struct hvc_struct *hp, int data)
+{
+	u32 size = wasm_driver_console_size();
+	struct winsize ws = hvc_wasm_winsize(size);
+	struct tty_struct *tty;
+	unsigned long flags;
+
+	spin_lock_irqsave(&hp->lock, flags);
+	hvc_wasm_size = size;
+	if (size)
+		hp->ws = ws;
+	spin_unlock_irqrestore(&hp->lock, flags);
+
+	tty = tty_port_tty_get(&hp->port);
+	if (tty && size)
+		tty_do_resize(tty, &ws);
+	tty_kref_put(tty);
+	return 0;
+}
+
+static const struct hv_ops hvc_wasm_ops = {
+	.get_chars = hvc_wasm_get_chars,
+	.put_chars = hvc_wasm_put_chars,
+	.notifier_add = hvc_wasm_notifier_add,
+};
+
+#ifdef WASM_IRQ_CONSOLE
+/* The host raises WASM_IRQ_CONSOLE on input or a resize: poll right away. */
+static irqreturn_t hvc_wasm_input_irq(int irq, void *dev_id)
+{
+	hvc_kick();
+	return IRQ_HANDLED;
+}
+#endif
+
+static int __init hvc_wasm_init(void)
+{
+	struct hvc_struct *hp = hvc_alloc(0, 0, &hvc_wasm_ops, PAGE_SIZE);
+
+	if (IS_ERR(hp))
+		return PTR_ERR(hp);
+	hvc_wasm_hp = hp;
+#ifdef WASM_IRQ_CONSOLE
+	if (request_irq(WASM_IRQ_CONSOLE, hvc_wasm_input_irq, 0, "hvc_wasm",
+			NULL))
+		pr_warn("hvc_wasm: no input interrupt, polling\n");
+#endif
+	return 0;
+}
+device_initcall(hvc_wasm_init);
+
+static int __init hvc_wasm_console_init(void)
+{
+	hvc_instantiate(0, 0, &hvc_wasm_ops);
+
+	return 0;
+}
+console_initcall(hvc_wasm_console_init);
