diff --git a/arch/wasm/Kconfig b/arch/wasm/Kconfig
new file mode 100644
index 000000000..a84bec4a1
--- /dev/null
+++ b/arch/wasm/Kconfig
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+menu "Wasm-specific options"
+
+#
+# Execution model (unkernel): the kernel is a single Wasm instance running
+# on one host thread. Kernel tasks are separate Wasm stacks switched with JSPI
+# (JavaScript Promise Integration). User mode is not Wasm: unmodified riscv64
+# Linux ELF programs run on a software CPU ("kwemu", see include/kw_emu.h in
+# the unkernel repository) that walks the kernel's Sv39-format page tables.
+#
+
+config WASM
+	bool
+	default y
+	select ARCH_NO_PREEMPT
+	# riscv64 user ABI: clone(flags, newsp, ptid, tls, ctid), as on riscv.
+	select CLONE_BACKWARDS
+	select HAVE_VIRT_CPU_ACCOUNTING_GEN
+	select HAVE_CONTEXT_TRACKING_USER
+
+	select THREAD_INFO_IN_TASK
+	select GENERIC_CPU_DEVICES
+	select GENERIC_ENTRY
+	select GENERIC_IRQ_SHOW
+	select GENERIC_CLOCKEVENTS
+	select GENERIC_SCHED_CLOCK
+	select HAVE_SYSCALL_TRACEPOINTS
+	select ARCH_HAVE_PANIC_NOTIFY
+	select ARCH_USE_BUILTIN_BSWAP
+	select ARCH_HAS_UBSAN
+	select ARCH_HAS_SYSCALL_WRAPPER
+	select ARCH_WANT_DEFAULT_TOPDOWN_MMAP_LAYOUT
+	select ARCH_HAS_PTE_SPECIAL
+	select HAVE_PAGE_SIZE_4KB
+	select VMALLOC_FLAT
+	select HAVE_ARCH_MMAP_RND_BITS
+	select LOCK_MM_AND_FIND_VMA
+
+# riscv64 ELF userspace runs on the kwemu software CPU with real page tables
+# (fork, mmap, copy-on-write). The original linux-wasm NOMMU mode (programs
+# as Wasm modules) is not supported by this port.
+config MMU
+	def_bool y
+
+config SMP
+	bool
+
+config 64BIT
+	def_bool y
+
+config HZ
+	int
+	default 100
+
+config NR_CPUS
+	int
+	default 1
+
+config GENERIC_CSUM
+	def_bool y
+
+config GENERIC_HWEIGHT
+	def_bool y
+
+config ARCH_HAVE_PANIC_NOTIFY
+	bool
+
+config KERNEL_START
+	hex "Kernel load address"
+	default "0x00010000"
+	help
+	  Address to load the kernel at. It is useful to leave a small area
+	  at the beginning of the memory to avoid dangling NULL pointers
+	  wreaking too much havoc.
+
+config ARCH_MMAP_RND_BITS_MIN
+	default 18
+
+config ARCH_MMAP_RND_BITS_MAX
+	default 24
+
+config PGTABLE_LEVELS
+	int
+	default 3
+
+endmenu
