diff --git a/arch/wasm/Makefile b/arch/wasm/Makefile
new file mode 100644
index 000000000..4492361d9
--- /dev/null
+++ b/arch/wasm/Makefile
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+KBUILD_DEFCONFIG := kw_defconfig
+
+# User mode is riscv64.
+UTS_MACHINE := riscv64
+
+KCFLAGS += -nostdlib -fno-builtin
+KCFLAGS += -march=wasm64
+KAFLAGS += -march=wasm64
+KBUILD_LDFLAGS += -mwasm64
+
+core-y += arch/wasm/kernel/
+core-y += arch/wasm/mm/
+libs-y += arch/wasm/lib/
+
+# Prebuilt guest CPU emulator (wasm64 static library or relocatable object
+# from unkernel's `zig build`: zig-out/lib/libkwemu.a or kwemu.o).
+ifneq ($(KWEMU),)
+libs-y += $(KWEMU)
+endif
+
+define archhelp
+	echo  '* vmlinux        - Standard Wasm kernel (KWEMU=/path/libkwemu.a)'
+endef
