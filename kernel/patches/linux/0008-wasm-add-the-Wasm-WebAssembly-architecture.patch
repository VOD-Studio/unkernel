diff --git a/arch/wasm/include/asm/syscall.h b/arch/wasm/include/asm/syscall.h
new file mode 100644
index 000000000..f5156cf17
--- /dev/null
+++ b/arch/wasm/include/asm/syscall.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_SYSCALL_H
+#define _ASM_WASM_SYSCALL_H
+
+#include <uapi/linux/audit.h>
+#include <linux/sched.h>
+#include <linux/err.h>
+#include <asm/ptrace.h>
+
+/* riscv64 syscall convention: a7 = nr, a0..a5 = args, a0 = return. */
+
+typedef long (*syscall_t)(const struct pt_regs *);
+extern void * const sys_call_table[];
+
+static inline int syscall_get_nr(struct task_struct *task, struct pt_regs *regs)
+{
+	return regs->user.x[REG_A7];
+}
+
+static inline void syscall_set_nr(struct task_struct *task,
+				  struct pt_regs *regs, int sysno)
+{
+	regs->user.x[REG_A7] = sysno;
+}
+
+static inline void syscall_rollback(struct task_struct *task,
+				    struct pt_regs *regs)
+{
+	regs->user.x[REG_A0] = regs->orig_a0;
+}
+
+static inline long syscall_get_error(struct task_struct *task,
+				     struct pt_regs *regs)
+{
+	unsigned long error = regs->user.x[REG_A0];
+
+	return IS_ERR_VALUE(error) ? error : 0;
+}
+
+static inline long syscall_get_return_value(struct task_struct *task,
+					    struct pt_regs *regs)
+{
+	return regs->user.x[REG_A0];
+}
+
+static inline void syscall_set_return_value(struct task_struct *task,
+					    struct pt_regs *regs,
+					    int error, long val)
+{
+	regs->user.x[REG_A0] = (long)error ?: val;
+}
+
+static inline void syscall_get_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 unsigned long *args)
+{
+	args[0] = regs->orig_a0;
+	args[1] = regs->user.x[11];
+	args[2] = regs->user.x[12];
+	args[3] = regs->user.x[13];
+	args[4] = regs->user.x[14];
+	args[5] = regs->user.x[15];
+}
+
+static inline void syscall_set_arguments(struct task_struct *task,
+					 struct pt_regs *regs,
+					 const unsigned long *args)
+{
+	regs->orig_a0 = args[0];
+	regs->user.x[10] = args[0];
+	regs->user.x[11] = args[1];
+	regs->user.x[12] = args[2];
+	regs->user.x[13] = args[3];
+	regs->user.x[14] = args[4];
+	regs->user.x[15] = args[5];
+}
+
+static inline int syscall_get_arch(struct task_struct *task)
+{
+	return AUDIT_ARCH_RISCV64;
+}
+
+static inline bool arch_syscall_is_vdso_sigreturn(struct pt_regs *regs)
+{
+	return false;
+}
+
+asmlinkage long __wasm_sys_ni_syscall(const struct pt_regs *);
+
+#endif /* _ASM_WASM_SYSCALL_H */
diff --git a/arch/wasm/include/asm/syscall_wrapper.h b/arch/wasm/include/asm/syscall_wrapper.h
new file mode 100644
index 000000000..7333b572a
--- /dev/null
+++ b/arch/wasm/include/asm/syscall_wrapper.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Syscall wrappers: every syscall gets a uniform (const struct pt_regs *)
+ * entry point, so the table can be called through one Wasm function type.
+ * Based on arch/riscv/include/asm/syscall_wrapper.h.
+ */
+
+#ifndef __ASM_SYSCALL_WRAPPER_H
+#define __ASM_SYSCALL_WRAPPER_H
+
+#include <asm/ptrace.h>
+
+asmlinkage long __wasm_sys_ni_syscall(const struct pt_regs *);
+
+#define __SYSCALL_SE_DEFINEx(x, prefix, name, ...)					\
+	static long __se_##prefix##name(__MAP(x,__SC_LONG,__VA_ARGS__));		\
+	static long __se_##prefix##name(__MAP(x,__SC_LONG,__VA_ARGS__))
+
+#define SC_WASM_REGS_TO_ARGS(nargs, ...)						\
+	__MAP(nargs,__SC_ARGS								\
+	      ,,regs->orig_a0,,regs->user.x[11],,regs->user.x[12]			\
+	      ,,regs->user.x[13],,regs->user.x[14],,regs->user.x[15],,regs->user.x[16])
+
+#define __SYSCALL_DEFINEx(x, name, ...)						\
+	asmlinkage long __wasm_sys##name(const struct pt_regs *regs);		\
+	ALLOW_ERROR_INJECTION(__wasm_sys##name, ERRNO);				\
+	static inline long __do_sys##name(__MAP(x,__SC_DECL,__VA_ARGS__));	\
+	__SYSCALL_SE_DEFINEx(x, sys, name, __VA_ARGS__)				\
+	{									\
+		long ret = __do_sys##name(__MAP(x,__SC_CAST,__VA_ARGS__));	\
+		__MAP(x,__SC_TEST,__VA_ARGS__);					\
+		__PROTECT(x, ret,__MAP(x,__SC_ARGS,__VA_ARGS__));		\
+		return ret;							\
+	}									\
+	asmlinkage long __wasm_sys##name(const struct pt_regs *regs)		\
+	{									\
+		return __se_sys##name(SC_WASM_REGS_TO_ARGS(x,__VA_ARGS__));	\
+	}									\
+	static inline long __do_sys##name(__MAP(x,__SC_DECL,__VA_ARGS__))
+
+#define SYSCALL_DEFINE0(sname)							\
+	SYSCALL_METADATA(_##sname, 0);						\
+	asmlinkage long __wasm_sys_##sname(const struct pt_regs *__unused);	\
+	ALLOW_ERROR_INJECTION(__wasm_sys_##sname, ERRNO);			\
+	asmlinkage long __wasm_sys_##sname(const struct pt_regs *__unused)
+
+#define COND_SYSCALL(name)							\
+	asmlinkage long __weak __wasm_sys_##name(const struct pt_regs *regs);	\
+	asmlinkage long __weak __wasm_sys_##name(const struct pt_regs *regs)	\
+	{									\
+		return sys_ni_syscall();					\
+	}
+
+#endif /* __ASM_SYSCALL_WRAPPER_H */
diff --git a/arch/wasm/include/asm/thread_info.h b/arch/wasm/include/asm/thread_info.h
new file mode 100644
index 000000000..aa4b53abe
--- /dev/null
+++ b/arch/wasm/include/asm/thread_info.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_THREAD_INFO_H
+#define _ASM_WASM_THREAD_INFO_H
+
+#include <asm/page.h>
+#include <asm/cache.h>
+
+/*
+ * The kernel stack is the C "shadow" stack in linear memory, addressed by the
+ * __stack_pointer Wasm global. Wasm locals and return addresses live on the
+ * engine's own stack (one per task, switched with JSPI), so usage is modest,
+ * but the emulator and deep VFS paths share it: use 16 KiB.
+ */
+#define THREAD_SIZE_ORDER	(2)
+#define THREAD_SIZE		(PAGE_SIZE << THREAD_SIZE_ORDER)
+#define THREAD_MASK		(~(THREAD_SIZE - 1))
+
+#ifndef __ASSEMBLER__
+
+struct thread_info {
+	unsigned long		flags;		/* low level flags */
+	int			preempt_count;
+	unsigned int		cpu;
+	unsigned long		syscall_work;	/* SYSCALL_WORK_ flags */
+};
+
+#define INIT_THREAD_INFO(tsk)			\
+{						\
+	.flags = 0,				\
+	.preempt_count = INIT_PREEMPT_COUNT,	\
+}
+
+#endif /* !__ASSEMBLER__ */
+
+#include <asm-generic/thread_info_tif.h>
+
+/* Architecture specific bits (16-31): */
+#define TIF_NEVER_RUN		16	/* was never run by the scheduler */
+#define _TIF_NEVER_RUN		(1 << TIF_NEVER_RUN)
+
+#endif /* _ASM_WASM_THREAD_INFO_H */
