diff --git a/arch/wasm/include/asm/wasi.h b/arch/wasm/include/asm/wasi.h
new file mode 100644
index 000000000..5d48bd33c
--- /dev/null
+++ b/arch/wasm/include/asm/wasi.h
@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * WASI preview 1 (module "wasi_snapshot_preview1") imports used by the kernel.
+ *
+ * The preview 1 ABI is the wasm32 one: every pointer and size argument is a
+ * u32 offset into linear memory and structs use the wasm32 layout, also in
+ * the wasm64 build. Pass pointers through wasi_ptr(), which stops the kernel
+ * if an address does not fit (only possible with a memory64 kernel and more
+ * than 4 GiB of RAM). Buffers that may live anywhere in RAM go through the
+ * bounce buffer in arch/wasm/kernel/wasi.c instead; fixed-size arguments use
+ * static storage in the kernel image, which is always below 4 GiB.
+ */
+
+#ifndef _ASM_WASM_WASI_H
+#define _ASM_WASM_WASI_H
+
+#include <linux/build_bug.h>
+#include <linux/compiler.h>
+#include <linux/limits.h>
+#include <linux/stddef.h>
+#include <linux/types.h>
+
+#define __wasi_import(name) \
+	__attribute__((import_module("wasi_snapshot_preview1"), import_name(#name)))
+
+/* errno */
+#define WASI_ESUCCESS		0
+#define WASI_EAGAIN		6
+#define WASI_EBADF		8
+#define WASI_EINVAL		28
+#define WASI_ENOENT		44
+
+/* clockid */
+#define WASI_CLOCK_REALTIME	0
+#define WASI_CLOCK_MONOTONIC	1
+
+/* eventtype (subscription tag / event type) */
+#define WASI_EVENTTYPE_CLOCK	0
+#define WASI_EVENTTYPE_FD_READ	1
+#define WASI_EVENTTYPE_FD_WRITE	2
+
+/* eventrwflags */
+#define WASI_EVENT_FD_READWRITE_HANGUP	1
+
+/* preopentype */
+#define WASI_PREOPENTYPE_DIR	0
+
+/* filetype */
+#define WASI_FILETYPE_REGULAR_FILE	4
+
+/* lookupflags */
+#define WASI_LOOKUP_SYMLINK_FOLLOW	1
+
+/* rights */
+#define WASI_RIGHT_FD_READ		(1ULL << 1)
+#define WASI_RIGHT_FD_FILESTAT_GET	(1ULL << 21)
+
+struct wasi_iovec {
+	u32 buf;
+	u32 buf_len;
+};
+
+struct wasi_subscription {
+	u64 userdata;
+	u8 tag;				/* WASI_EVENTTYPE_* */
+	union {
+		struct {
+			u32 id;		/* clockid */
+			u64 timeout;	/* ns */
+			u64 precision;	/* ns */
+			u16 flags;	/* bit 0: timeout is absolute */
+		} clock;
+		struct {
+			u32 fd;
+		} fd_readwrite;
+	} u;
+};
+
+struct wasi_event {
+	u64 userdata;
+	u16 error;
+	u8 type;
+	struct {
+		u64 nbytes;
+		u16 flags;		/* WASI_EVENT_FD_READWRITE_* */
+	} fd_readwrite;
+};
+
+struct wasi_prestat {
+	u8 tag;				/* WASI_PREOPENTYPE_* */
+	u32 dir_name_len;
+};
+
+struct wasi_filestat {
+	u64 dev;
+	u64 ino;
+	u8 filetype;
+	u64 nlink;
+	u64 size;
+	u64 atim;
+	u64 mtim;
+	u64 ctim;
+};
+
+static_assert(sizeof(struct wasi_iovec) == 8);
+static_assert(sizeof(struct wasi_subscription) == 48);
+static_assert(offsetof(struct wasi_subscription, u.clock.timeout) == 24);
+static_assert(offsetof(struct wasi_subscription, u.clock.flags) == 40);
+static_assert(sizeof(struct wasi_event) == 32);
+static_assert(offsetof(struct wasi_event, fd_readwrite.flags) == 24);
+static_assert(sizeof(struct wasi_prestat) == 8);
+static_assert(sizeof(struct wasi_filestat) == 64);
+static_assert(offsetof(struct wasi_filestat, size) == 32);
+
+int wasi_args_sizes_get(u32 argc, u32 argv_buf_size) __wasi_import(args_sizes_get);
+int wasi_args_get(u32 argv, u32 argv_buf) __wasi_import(args_get);
+int wasi_clock_time_get(u32 id, u64 precision, u32 time) __wasi_import(clock_time_get);
+int wasi_random_get(u32 buf, u32 buf_len) __wasi_import(random_get);
+int wasi_fd_write(u32 fd, u32 iovs, u32 iovs_len, u32 nwritten) __wasi_import(fd_write);
+int wasi_fd_read(u32 fd, u32 iovs, u32 iovs_len, u32 nread) __wasi_import(fd_read);
+int wasi_fd_close(u32 fd) __wasi_import(fd_close);
+int wasi_fd_filestat_get(u32 fd, u32 buf) __wasi_import(fd_filestat_get);
+int wasi_fd_prestat_get(u32 fd, u32 buf) __wasi_import(fd_prestat_get);
+int wasi_fd_prestat_dir_name(u32 fd, u32 path, u32 path_len) __wasi_import(fd_prestat_dir_name);
+int wasi_path_open(u32 fd, u32 dirflags, u32 path, u32 path_len, u32 oflags,
+		   u64 fs_rights_base, u64 fs_rights_inheriting, u32 fdflags,
+		   u32 opened_fd) __wasi_import(path_open);
+int wasi_poll_oneoff(u32 in, u32 out, u32 nsubscriptions, u32 nevents) __wasi_import(poll_oneoff);
+int wasi_sched_yield(void) __wasi_import(sched_yield);
+void __noreturn wasi_proc_exit(u32 rval) __wasi_import(proc_exit);
+
+void __noreturn wasi_bad_ptr(const void *p);
+
+static __always_inline u32 wasi_ptr(const void *p)
+{
+	unsigned long addr = (unsigned long)p;
+
+	if (unlikely(addr > U32_MAX))
+		wasi_bad_ptr(p);
+	return addr;
+}
+
+#endif /* _ASM_WASM_WASI_H */
diff --git a/arch/wasm/include/asm/wasm.h b/arch/wasm/include/asm/wasm.h
new file mode 100644
index 000000000..d78af949e
--- /dev/null
+++ b/arch/wasm/include/asm/wasm.h
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_WASM_H
+#define _ASM_WASM_WASM_H
+
+#include <linux/compiler.h>
+#include <linux/init.h>
+#include <linux/types.h>
+
+/*
+ * The host interface has two parts:
+ *
+ *  - Generic services (clocks, randomness, the console, idle, exit, the
+ *    command line and the initrd) are WASI preview 1 imports (asm/wasi.h).
+ *    The wrappers below are in arch/wasm/kernel/wasi.c.
+ *  - Everything else is imported from module "unkernel" (__unkernel_import),
+ *    which only an unkernel host provides (js/core/kernel.ts in unkernel):
+ *    task switching, kwblk, kwnet, the console window size and a host stack
+ *    trace.
+ *  - When kwemu is built with its JIT tier (unkernel's default), the kwemu
+ *    library itself also imports kw_host_jit_caps, kw_host_jit_compile and
+ *    kw_host_jit_free from module "unkernel" (contract in asm/kw_emu.h).
+ *    The kernel never calls them; a host without a JIT returns 0 from
+ *    kw_host_jit_caps(), and kwemu then only interprets.
+ *
+ * Functions marked (JSPI) may suspend the current Wasm stack: in the
+ * JavaScript host they are WebAssembly.Suspending imports.
+ */
+#define __unkernel_import(name) \
+	__attribute__((import_module("unkernel"), import_name(#name)))
+
+struct task_struct;
+
+/* WASI wrappers (wasi.c). */
+u64 wasm_cpu_clock_get_monotonic(void);
+u64 wasm_clock_get_realtime(void);
+/* Power off (0), halt (1) or restart (2): proc_exit(code). */
+void __noreturn wasm_halt(int code);
+/* Panic text to stderr, then proc_exit(253). */
+void __noreturn wasm_panic(const char *msg);
+/* (JSPI) Sleep until @timeout_ns passes (-1: forever) or a host event. */
+void wasm_idle(long long timeout_ns);
+/* (JSPI) Let the host event loop run (input, timers) and come back. */
+void wasm_yield(void);
+/* Console (fds 1 and 0). wasm_console_read() never blocks. */
+ssize_t wasm_console_write(const u8 *buf, size_t count);
+ssize_t wasm_console_read(u8 *buf, size_t count);
+/* Fill boot_command_line from the WASI arguments (argv[1..], joined). */
+void __init wasm_setup_cmdline(void);
+/* Read the file "initrd" of a preopened directory, if any (CONFIG_BLK_DEV_INITRD). */
+void __init wasm_load_initrd(void);
+
+void wasm_dump_stacktrace(char *buffer, unsigned long max_size)
+	__unkernel_import(wasm_dump_stacktrace);
+
+/*
+ * Console window size, rows << 16 | cols, or 0 if unknown. hvc_wasm reads it
+ * when the tty is opened and on each input poll; the host raises
+ * WASM_IRQ_CONSOLE after a change.
+ */
+u32 wasm_driver_console_size(void)
+	__unkernel_import(wasm_driver_console_size);
+
+/*
+ * (JSPI) Suspend @prev, then run @next: resume it, or if @next has never run,
+ * start it on a fresh Wasm stack via the ret_from_fork export. Returns the
+ * task that switched back to @prev. When @prev_dead is set, @prev will never
+ * be resumed and the host may drop its stack. Called from entry.S.
+ */
+struct task_struct *wasm_switch_to(struct task_struct *prev,
+				   struct task_struct *next,
+				   int next_is_new, int prev_dead)
+	__unkernel_import(wasm_switch_to);
+
+/* Bits set by the host in wasm_host_irqs (see irq.h). */
+extern u32 wasm_host_irqs;
+
+#endif /* _ASM_WASM_WASM_H */
