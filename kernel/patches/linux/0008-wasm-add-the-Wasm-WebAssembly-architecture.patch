diff --git a/arch/wasm/kernel/entry.S b/arch/wasm/kernel/entry.S
new file mode 100644
index 000000000..6d2543676
--- /dev/null
+++ b/arch/wasm/kernel/entry.S
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <asm/thread_info.h>
+#include <asm/asm.h>
+
+#include <asm/asm-offsets.h>
+
+.section .globals,"",@
+
+/* The running task (like a "tp" register). */
+.globl current
+.globaltype current, iLONG
+current:
+
+.section .text,"",@
+
+.functype wasm_switch_to(iLONG, iLONG, i32, i32) -> (iLONG)
+.import_module wasm_switch_to, unkernel
+.import_name wasm_switch_to, wasm_switch_to
+.functype __ret_from_fork(iLONG) -> ()
+
+/*
+ * struct task_struct *wasm_arch_switch(prev, next, next_is_new, prev_dead)
+ *
+ * The host import suspends this Wasm stack (JSPI) and runs next. When some
+ * task later switches back to prev, the import returns here: the Wasm locals
+ * (and so prev's __stack_pointer) were preserved on the suspended stack.
+ */
+.globl wasm_arch_switch
+wasm_arch_switch:
+	.functype wasm_arch_switch(iLONG, iLONG, i32, i32) -> (iLONG)
+	.local iLONG, iLONG /* 4: saved __stack_pointer, 5: last */
+
+	global.get __stack_pointer
+	local.set 4
+
+	local.get 1
+	global.set current
+
+	local.get 0
+	local.get 1
+	local.get 2
+	local.get 3
+	call wasm_switch_to
+	local.set 5
+
+	local.get 4
+	global.set __stack_pointer
+	local.get 0
+	global.set current
+
+	local.get 5
+	end_function
+
+/*
+ * ret_from_fork(prev, next): entry point of every new task, called by the
+ * host on a fresh Wasm stack (JSPI "promising" export). Never returns.
+ */
+.globl ret_from_fork
+ret_from_fork:
+	.functype ret_from_fork(iLONG, iLONG) -> ()
+
+	local.get 1
+	global.set current
+
+	local.get 1
+	iLONG.const zeroptr+TASK_STRUCT_STACK
+	iLONG.add
+	iLONG.load 0
+	iLONG.const zeroptr+THREAD_STACK_START
+	iLONG.add
+	global.set __stack_pointer
+
+	local.get 0
+	call __ret_from_fork
+	unreachable
+	end_function
diff --git a/arch/wasm/kernel/head.S b/arch/wasm/kernel/head.S
new file mode 100644
index 000000000..6f84fb37f
--- /dev/null
+++ b/arch/wasm/kernel/head.S
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <asm/processor.h>
+#include <asm/asm.h>
+
+#include <asm/asm-offsets.h>
+
+.functype start_kernel() -> ()
+
+/*
+ * vmlinux entry point, called by the host (as a JSPI "promising" export) once
+ * linear memory has been sized. The command line and the initrd come from
+ * WASI (wasm_setup_cmdline(), wasm_load_initrd()).
+ */
+.globl _start
+_start:
+	.functype _start() -> ()
+
+	iLONG.const init_task
+	global.set current
+
+	iLONG.const init_stack+THREAD_STACK_START
+	global.set __stack_pointer
+
+	iLONG.const memory_start
+	iLONG.const CONFIG_KERNEL_START
+	iLONG.store 0
+
+	iLONG.const memory_end
+	WASM_MEMORY_SIZE
+	iLONG.const _WASM_PAGE_SIZE
+	iLONG.mul
+	iLONG.store 0
+
+	call start_kernel
+	end_function
diff --git a/arch/wasm/kernel/irq.c b/arch/wasm/kernel/irq.c
new file mode 100644
index 000000000..5715be576
--- /dev/null
+++ b/arch/wasm/kernel/irq.c
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Interrupts. There is one CPU and no asynchronous delivery: pending
+ * "interrupts" (the clockevent expiring, host events such as console input)
+ * are polled when user mode traps back into the kernel and in the idle loop.
+ */
+
+#include <linux/irq.h>
+#include <linux/irqchip.h>
+#include <linux/irq-entry-common.h>
+#include <linux/hardirq.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+#include <asm/irq.h>
+#include <asm/irq_regs.h>
+#include <asm/time.h>
+#include <asm/wasm.h>
+
+/* Written by the host (any time the kernel is suspended). */
+u32 wasm_host_irqs;
+
+static void wasm_irq_noop(struct irq_data *data)
+{
+}
+
+static struct irq_chip wasm_irq_chip = {
+	.name		= "wasm",
+	.irq_mask	= wasm_irq_noop,
+	.irq_unmask	= wasm_irq_noop,
+	.flags		= IRQCHIP_SKIP_SET_WAKE,
+};
+
+void __init init_IRQ(void)
+{
+	int irq;
+
+	for (irq = 0; irq < NR_IRQS; ++irq)
+		irq_set_chip_and_handler(irq, &wasm_irq_chip, handle_simple_irq);
+}
+
+long long wasm_timer_timeout(void)
+{
+	long long expiry = READ_ONCE(wasm_timer_expiry);
+	long long now;
+
+	if (expiry < 0)
+		return -1;
+	now = wasm_cpu_clock_get_monotonic();
+	return now >= expiry ? 0 : expiry - now;
+}
+
+static u32 wasm_pending_irqs(void)
+{
+	u32 pending = READ_ONCE(wasm_host_irqs);
+
+	if (pending)
+		WRITE_ONCE(wasm_host_irqs, 0);
+	if (wasm_timer_timeout() == 0) {
+		WRITE_ONCE(wasm_timer_expiry, -1);
+		pending |= 1U << WASM_IRQ_TIMER;
+	}
+	return pending;
+}
+
+/* Caller did irqentry_enter*(): we are "in the interrupt" with irqs off. */
+void wasm_poll_irqs(struct pt_regs *regs)
+{
+	struct pt_regs *old_regs;
+	u32 pending = wasm_pending_irqs();
+	int irq;
+
+	if (!pending)
+		return;
+
+	irq_enter_rcu();
+	old_regs = set_irq_regs(regs);
+	for (irq = 0; pending; irq++, pending >>= 1)
+		if (pending & 1)
+			generic_handle_irq(irq);
+	set_irq_regs(old_regs);
+	irq_exit_rcu();
+}
+
+/* Called with interrupts disabled; the generic idle loop re-enables them. */
+void arch_cpu_idle(void)
+{
+	struct pt_regs regs = { .kernel = 1, .irqflags = ARCH_IRQ_ENABLED,
+				.cause = PT_CAUSE_NONE };
+	irqentry_state_t state;
+	long long timeout = wasm_timer_timeout();
+
+	if (!READ_ONCE(wasm_host_irqs) && timeout != 0)
+		wasm_idle(timeout);
+
+	state = irqentry_enter(&regs);
+	wasm_poll_irqs(&regs);
+	irqentry_exit(&regs, state);
+}
