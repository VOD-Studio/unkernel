diff --git a/arch/wasm/kernel/signal.c b/arch/wasm/kernel/signal.c
new file mode 100644
index 000000000..3eceaadeb
--- /dev/null
+++ b/arch/wasm/kernel/signal.c
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Signal delivery with the riscv64 rt_sigframe/ucontext layout (no V
+ * extension state). Based on arch/riscv/kernel/signal.c.
+ *
+ * There is no vDSO: handlers return through a two-instruction trampoline
+ * ("li a7, __NR_rt_sigreturn; ecall") on a special page mapped into every
+ * process at exec (see arch/wasm/mm/sigpage.c).
+ */
+
+#include <linux/signal.h>
+#include <linux/uaccess.h>
+#include <linux/syscalls.h>
+#include <linux/resume_user_mode.h>
+#include <linux/linkage.h>
+#include <linux/entry-common.h>
+#include <linux/rseq.h>
+#include <asm/ucontext.h>
+#include <asm/syscall.h>
+#include <asm/kw_emu.h>
+
+extern struct kw_cpu *const wasm_kw_cpu;
+
+struct rt_sigframe {
+	struct siginfo info;
+	struct ucontext uc;
+};
+
+unsigned long signal_minsigstksz __ro_after_init;
+
+static size_t get_rt_frame_size(void)
+{
+	return round_up(sizeof(struct rt_sigframe), 16);
+}
+
+static long restore_sigcontext(struct pt_regs *regs,
+			       struct sigcontext __user *sc)
+{
+	struct user_regs_struct uregs;
+	struct __riscv_d_ext_state fstate;
+	__u32 rsvd, magic, size;
+	unsigned long *r = (unsigned long *)&uregs;
+	long err;
+	int i;
+
+	err = __copy_from_user(&uregs, &sc->sc_regs, sizeof(uregs));
+	err |= __copy_from_user(&fstate, &sc->sc_fpregs.d, sizeof(fstate));
+	err |= __get_user(rsvd, &sc->sc_extdesc.reserved);
+	err |= __get_user(magic, &sc->sc_extdesc.hdr.magic);
+	err |= __get_user(size, &sc->sc_extdesc.hdr.size);
+	if (err)
+		return -EFAULT;
+	if (rsvd || magic != END_MAGIC || size != END_HDR_SIZE)
+		return -EINVAL;
+
+	/* user_regs_struct is { pc, x1..x31 } */
+	regs->user.pc = r[0];
+	for (i = 1; i < 32; i++)
+		regs->user.x[i] = r[i];
+	memcpy(regs->user.f, fstate.f, sizeof(regs->user.f));
+	regs->user.fcsr = fstate.fcsr;
+	return 0;
+}
+
+SYSCALL_DEFINE0(rt_sigreturn)
+{
+	struct pt_regs *regs = current_pt_regs();
+	struct rt_sigframe __user *frame;
+	sigset_t set;
+
+	/* Always make any pending restarted system calls return -EINTR */
+	current->restart_block.fn = do_no_restart_syscall;
+
+	frame = (struct rt_sigframe __user *)regs->user.x[REG_SP];
+
+	if (!access_ok(frame, get_rt_frame_size()))
+		goto badframe;
+
+	if (__copy_from_user(&set, &frame->uc.uc_sigmask, sizeof(set)))
+		goto badframe;
+
+	set_current_blocked(&set);
+
+	if (restore_sigcontext(regs, &frame->uc.uc_mcontext))
+		goto badframe;
+
+	if (restore_altstack(&frame->uc.uc_stack))
+		goto badframe;
+
+	regs->cause = PT_CAUSE_NONE;
+	kw_clear_reservation(wasm_kw_cpu);
+
+	return regs->user.x[REG_A0];
+
+badframe:
+	if (show_unhandled_signals)
+		pr_info_ratelimited("%s[%d]: bad frame in %s: frame=%p pc=%llx sp=%llx\n",
+				    current->comm, task_pid_nr(current), __func__,
+				    frame, regs->user.pc, regs->user.x[REG_SP]);
+	force_sig(SIGSEGV);
+	return 0;
+}
+
+static long setup_sigcontext(struct rt_sigframe __user *frame,
+			     struct pt_regs *regs)
+{
+	struct sigcontext __user *sc = &frame->uc.uc_mcontext;
+	struct user_regs_struct uregs;
+	struct __riscv_d_ext_state fstate;
+	unsigned long *r = (unsigned long *)&uregs;
+	long err;
+	int i;
+
+	r[0] = regs->user.pc;
+	for (i = 1; i < 32; i++)
+		r[i] = regs->user.x[i];
+	memcpy(fstate.f, regs->user.f, sizeof(fstate.f));
+	fstate.fcsr = regs->user.fcsr;
+
+	err = __copy_to_user(&sc->sc_regs, &uregs, sizeof(uregs));
+	err |= __copy_to_user(&sc->sc_fpregs.d, &fstate, sizeof(fstate));
+	/* Write zero to fp-reserved space and check it on restore_sigcontext */
+	err |= __put_user(0, &sc->sc_extdesc.reserved);
+	/* And put END __riscv_ctx_hdr at the end. */
+	err |= __put_user(END_MAGIC, &sc->sc_extdesc.hdr.magic);
+	err |= __put_user(END_HDR_SIZE, &sc->sc_extdesc.hdr.size);
+
+	return err;
+}
+
+static inline void __user *get_sigframe(struct ksignal *ksig,
+					struct pt_regs *regs, size_t framesize)
+{
+	unsigned long sp = regs->user.x[REG_SP];
+
+	/*
+	 * If we are on the alternate signal stack and would overflow it, don't.
+	 * Return an always-bogus address instead so we will die with SIGSEGV.
+	 */
+	if (on_sig_stack(sp) && !likely(on_sig_stack(sp - framesize)))
+		return (void __user __force *)(-1UL);
+
+	sp = sigsp(sp, ksig) - framesize;
+	sp &= ~0xfUL;
+	return (void __user *)sp;
+}
+
+static int setup_rt_frame(struct ksignal *ksig, sigset_t *set,
+			  struct pt_regs *regs)
+{
+	struct rt_sigframe __user *frame;
+	size_t frame_size = get_rt_frame_size();
+	long err = 0;
+
+	frame = get_sigframe(ksig, regs, frame_size);
+	if (!access_ok(frame, frame_size))
+		return -EFAULT;
+
+	err |= copy_siginfo_to_user(&frame->info, &ksig->info);
+
+	err |= __put_user(0, &frame->uc.uc_flags);
+	err |= __put_user(NULL, &frame->uc.uc_link);
+	err |= __save_altstack(&frame->uc.uc_stack, regs->user.x[REG_SP]);
+	err |= setup_sigcontext(frame, regs);
+	err |= __copy_to_user(&frame->uc.uc_sigmask, set, sizeof(*set));
+	if (err)
+		return -EFAULT;
+
+	/* A handler must not complete an interrupted LR/SC sequence. */
+	kw_clear_reservation(wasm_kw_cpu);
+
+	regs->user.x[REG_RA] = current->mm->context.sigpage;
+	regs->user.pc = (unsigned long)ksig->ka.sa.sa_handler;
+	regs->user.x[REG_SP] = (unsigned long)frame;
+	regs->user.x[REG_A0] = ksig->sig;
+	regs->user.x[11] = (unsigned long)&frame->info;
+	regs->user.x[12] = (unsigned long)&frame->uc;
+
+	return 0;
+}
+
+static void handle_signal(struct ksignal *ksig, struct pt_regs *regs)
+{
+	sigset_t *oldset = sigmask_to_save();
+	int ret;
+
+	rseq_signal_deliver(ksig, regs);
+	ret = setup_rt_frame(ksig, oldset, regs);
+	signal_setup_done(ret, ksig, 0);
+}
+
+void arch_do_signal_or_restart(struct pt_regs *regs)
+{
+	unsigned long continue_addr = 0, restart_addr = 0;
+	int retval = 0;
+	struct ksignal ksig;
+	bool syscall = (regs->cause == PT_CAUSE_SYSCALL);
+
+	if (syscall) {
+		continue_addr = regs->user.pc;
+		restart_addr = continue_addr - 4;
+		retval = regs->user.x[REG_A0];
+
+		/* Avoid additional syscall restarting */
+		regs->cause = PT_CAUSE_NONE;
+
+		switch (retval) {
+		case -ERESTARTNOHAND:
+		case -ERESTARTSYS:
+		case -ERESTARTNOINTR:
+		case -ERESTART_RESTARTBLOCK:
+			regs->user.x[REG_A0] = regs->orig_a0;
+			regs->user.pc = restart_addr;
+			break;
+		}
+	}
+
+	if (get_signal(&ksig)) {
+		if (regs->user.pc == restart_addr &&
+		    (retval == -ERESTARTNOHAND ||
+		     retval == -ERESTART_RESTARTBLOCK ||
+		     (retval == -ERESTARTSYS &&
+		      !(ksig.ka.sa.sa_flags & SA_RESTART)))) {
+			regs->user.x[REG_A0] = -EINTR;
+			regs->user.pc = continue_addr;
+		}
+
+		handle_signal(&ksig, regs);
+		return;
+	}
+
+	if (syscall && regs->user.pc == restart_addr &&
+	    retval == -ERESTART_RESTARTBLOCK)
+		regs->user.x[REG_A7] = __NR_restart_syscall;
+
+	restore_saved_sigmask();
+}
+
+static int __init init_signal_minsigstksz(void)
+{
+	signal_minsigstksz = get_rt_frame_size();
+	return 0;
+}
+arch_initcall(init_signal_minsigstksz);
diff --git a/arch/wasm/kernel/sync.c b/arch/wasm/kernel/sync.c
new file mode 100644
index 000000000..b2052cce6
--- /dev/null
+++ b/arch/wasm/kernel/sync.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Host-requested sync. The host sets WASM_IRQ_SYNC in wasm_host_irqs when it
+ * may lose the session soon (a browser tab being hidden or closed), and then
+ * waits for the device flush that follows. The handler runs in interrupt
+ * context, so it only queues the work, which does what sync(2) does: write
+ * back every filesystem, commit the journals and flush the devices.
+ * Requests that arrive before the work runs coalesce into one sync; one that
+ * arrives while it runs queues it once more.
+ */
+
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/syscalls.h>
+#include <linux/workqueue.h>
+#include <asm/irq.h>
+
+static void wasm_sync_work_fn(struct work_struct *work)
+{
+	ksys_sync();
+}
+
+static DECLARE_WORK(wasm_sync_work, wasm_sync_work_fn);
+
+static irqreturn_t wasm_sync_irq(int irq, void *dev_id)
+{
+	queue_work(system_dfl_wq, &wasm_sync_work);
+	return IRQ_HANDLED;
+}
+
+static int __init wasm_sync_init(void)
+{
+	return request_irq(WASM_IRQ_SYNC, wasm_sync_irq, 0, "sync", NULL);
+}
+device_initcall(wasm_sync_init);
diff --git a/arch/wasm/kernel/syscall_table.c b/arch/wasm/kernel/syscall_table.c
new file mode 100644
index 000000000..51e05d3b9
--- /dev/null
+++ b/arch/wasm/kernel/syscall_table.c
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* riscv64 syscall table (generated from scripts/syscall.tbl, abi "riscv"). */
+
+#include <linux/linkage.h>
+#include <linux/syscalls.h>
+#include <asm-generic/syscalls.h>
+#include <asm/syscall.h>
+
+#define __SYSCALL_WITH_COMPAT(nr, native, compat) __SYSCALL(nr, native)
+
+#undef __SYSCALL
+#define __SYSCALL(nr, call)	asmlinkage long __wasm_##call(const struct pt_regs *);
+#include <asm/syscall_table_64.h>
+
+#undef __SYSCALL
+#define __SYSCALL(nr, call)	[nr] = __wasm_##call,
+
+void * const sys_call_table[__NR_syscalls] = {
+	[0 ... __NR_syscalls - 1] = __wasm_sys_ni_syscall,
+#include <asm/syscall_table_64.h>
+};
diff --git a/arch/wasm/kernel/time.c b/arch/wasm/kernel/time.c
new file mode 100644
index 000000000..52a4707ef
--- /dev/null
+++ b/arch/wasm/kernel/time.c
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <linux/clocksource.h>
+#include <linux/clockchips.h>
+#include <linux/interrupt.h>
+#include <linux/timekeeping.h>
+#include <linux/sched_clock.h>
+
+#include <asm/irq.h>
+#include <asm/time.h>
+#include <asm/wasm.h>
+
+long long wasm_timer_expiry = -1;
+
+static u64 wasm_clocksource_read(struct clocksource *cs)
+{
+	return wasm_cpu_clock_get_monotonic();
+}
+
+static u64 notrace wasm_sched_clock_read(void)
+{
+	return wasm_cpu_clock_get_monotonic();
+}
+
+static struct clocksource wasm_clocksource = {
+	.name	= "wasm_clock",
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+	.rating	= 300,
+	.read	= wasm_clocksource_read,
+	.mask	= CLOCKSOURCE_MASK(64),
+};
+
+static int wasm_clockevent_set_next_event(unsigned long delta,
+					  struct clock_event_device *dev)
+{
+	WRITE_ONCE(wasm_timer_expiry,
+		   (long long)wasm_cpu_clock_get_monotonic() + delta);
+	return 0;
+}
+
+static int wasm_clockevent_shutdown(struct clock_event_device *dev)
+{
+	WRITE_ONCE(wasm_timer_expiry, -1);
+	return 0;
+}
+
+static struct clock_event_device wasm_clockevent = {
+	.name			= "wasm_timer",
+	.features		= CLOCK_EVT_FEAT_ONESHOT,
+	.rating			= 300,
+	.set_next_event		= wasm_clockevent_set_next_event,
+	.set_state_shutdown	= wasm_clockevent_shutdown,
+	.set_state_oneshot_stopped = wasm_clockevent_shutdown,
+};
+
+static irqreturn_t wasm_timer_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *ce = dev_id;
+
+	ce->event_handler(ce);
+	return IRQ_HANDLED;
+}
+
+void read_persistent_clock64(struct timespec64 *ts)
+{
+	u64 ns = wasm_clock_get_realtime();
+
+	ts->tv_sec = div_u64(ns, NSEC_PER_SEC);
+	ts->tv_nsec = ns - ts->tv_sec * NSEC_PER_SEC;
+}
+
+void __init time_init(void)
+{
+	sched_clock_register(wasm_sched_clock_read, 64, NSEC_PER_SEC);
+	if (clocksource_register_khz(&wasm_clocksource, 1000000))
+		panic("wasm: cannot register clocksource");
+
+	if (request_irq(WASM_IRQ_TIMER, wasm_timer_interrupt, IRQF_TIMER,
+			"wasm-timer", &wasm_clockevent))
+		panic("wasm: cannot request timer irq");
+
+	wasm_clockevent.cpumask = cpumask_of(0);
+	wasm_clockevent.irq = WASM_IRQ_TIMER;
+	clockevents_config_and_register(&wasm_clockevent, NSEC_PER_SEC, 1000,
+					ULONG_MAX);
+}
diff --git a/arch/wasm/kernel/traps.c b/arch/wasm/kernel/traps.c
new file mode 100644
index 000000000..dd66e3abb
--- /dev/null
+++ b/arch/wasm/kernel/traps.c
@@ -0,0 +1,151 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * User mode: the "return to user" path of every user task is a loop around
+ * kw_run(), which executes riscv64 user code until it traps back into the
+ * kernel (syscall, page fault, illegal instruction, budget/interrupt).
+ */
+
+#include <linux/entry-common.h>
+#include <linux/irq-entry-common.h>
+#include <linux/nospec.h>
+#include <linux/ptrace.h>
+#include <linux/sched.h>
+#include <linux/sched/debug.h>
+#include <linux/signal.h>
+#include <linux/syscalls.h>
+#include <asm/entry.h>
+#include <asm/irq.h>
+#include <asm/kw_emu.h>
+#include <asm/syscall.h>
+#include <asm/wasm.h>
+
+extern struct kw_cpu *const wasm_kw_cpu;
+
+/*
+ * Instructions per slice; timers, host IRQs and the host yield are checked
+ * between slices. The slice belongs to the CPU, not to one kw_run() call:
+ * it runs on across kernel entries and task switches, and each syscall or
+ * page fault is charged KW_ENTRY_COST instructions. Otherwise a loop that
+ * keeps entering the kernel never ends a slice, so the timer never fires,
+ * nothing is preempted and the host never runs: apt polls dpkg's status
+ * pipe with pselect() after EOF until dpkg exits, and dpkg never ran again.
+ */
+#define KW_SLICE	200000ULL
+#define KW_ENTRY_COST	1000ULL
+/* Let the host event loop breathe at least this often while user code runs. */
+#define KW_YIELD_NS	(20 * NSEC_PER_MSEC)
+
+static u64 last_yield_ns;
+
+int show_unhandled_signals = 1;
+
+asmlinkage long sys_ni_syscall(void);
+
+asmlinkage long __wasm_sys_ni_syscall(const struct pt_regs *__unused)
+{
+	return sys_ni_syscall();
+}
+
+static void do_syscall(struct pt_regs *regs)
+{
+	long nr = regs->user.x[REG_A7];
+
+	regs->orig_a0 = regs->user.x[REG_A0];
+	regs->cause = PT_CAUSE_SYSCALL;
+
+	regs->user.x[REG_A0] = -ENOSYS;
+
+	/* False: skip the call and keep a0 (a tracer or seccomp may have set it). */
+	if (syscall_enter_from_user_mode_randomize_stack(regs, &nr) &&
+	    nr >= 0 && nr < NR_syscalls) {
+		nr = array_index_nospec(nr, NR_syscalls);
+		regs->user.x[REG_A0] = ((syscall_t)sys_call_table[nr])(regs);
+	}
+
+	syscall_exit_to_user_mode(regs);
+}
+
+static void do_user_trap(struct pt_regs *regs, int signo, int code,
+			 unsigned long addr)
+{
+	irqentry_enter_from_user_mode(regs);
+	local_irq_enable();
+	if (show_unhandled_signals && unhandled_signal(current, signo))
+		pr_info_ratelimited("%s[%d]: unhandled trap sig=%d pc=%llx addr=%lx insn=%llx\n",
+				    current->comm, task_pid_nr(current), signo,
+				    regs->user.pc, addr,
+				    (unsigned long long)wasm_kw_cpu->ev.insn);
+	force_sig_fault(signo, code, (void __user *)addr);
+	local_irq_disable();
+	irqentry_exit_to_user_mode(regs);
+}
+
+static void do_user_fault(struct pt_regs *regs, unsigned long addr,
+			  unsigned int access)
+{
+	regs->badaddr = addr;
+	irqentry_enter_from_user_mode(regs);
+	local_irq_enable();
+	do_user_page_fault(regs, addr, access);
+	local_irq_disable();
+	irqentry_exit_to_user_mode(regs);
+}
+
+static void do_user_interrupt(struct pt_regs *regs)
+{
+	u64 now = wasm_cpu_clock_get_monotonic();
+
+	if (now - last_yield_ns >= KW_YIELD_NS) {
+		wasm_yield();
+		last_yield_ns = wasm_cpu_clock_get_monotonic();
+	}
+
+	irqentry_enter_from_user_mode(regs);
+	wasm_poll_irqs(regs);
+	irqentry_exit_to_user_mode(regs);
+}
+
+void __noreturn user_mode_loop(struct pt_regs *regs)
+{
+	struct kw_cpu *cpu = wasm_kw_cpu;
+	unsigned int ev;
+
+	for (;;) {
+		regs->cause = PT_CAUSE_NONE;
+
+		/* "sret": user mode runs with interrupts enabled. */
+		local_irq_enable();
+		ev = kw_run(cpu, &regs->user);
+		local_irq_disable();
+
+		/* A budget of 0 ends the next kw_run() at once (KW_EV_BUDGET). */
+		if (ev == KW_EV_SYSCALL || ev == KW_EV_FAULT)
+			cpu->budget -= min(cpu->budget, KW_ENTRY_COST);
+
+		switch (ev) {
+		case KW_EV_SYSCALL:
+			do_syscall(regs);
+			break;
+		case KW_EV_FAULT:
+			do_user_fault(regs, cpu->ev.addr, cpu->ev.access);
+			break;
+		case KW_EV_ILLEGAL:
+			do_user_trap(regs, SIGILL, ILL_ILLOPC, regs->user.pc);
+			break;
+		case KW_EV_BREAKPOINT:
+			do_user_trap(regs, SIGTRAP, TRAP_BRKPT, regs->user.pc);
+			break;
+		case KW_EV_MISALIGNED:
+			do_user_trap(regs, SIGBUS, BUS_ADRALN, cpu->ev.addr);
+			break;
+		case KW_EV_BUDGET:
+		case KW_EV_INTERRUPT:
+			do_user_interrupt(regs);
+			cpu->budget = KW_SLICE;
+			break;
+		default:
+			do_user_trap(regs, SIGILL, ILL_ILLTRP, regs->user.pc);
+			break;
+		}
+	}
+}
diff --git a/arch/wasm/kernel/vmlinux.lds.S b/arch/wasm/kernel/vmlinux.lds.S
new file mode 100644
index 000000000..9385899a4
--- /dev/null
+++ b/arch/wasm/kernel/vmlinux.lds.S
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <asm/asm-offsets.h>
+
+#include <asm/vmlinux.lds.h>
+#include <asm/thread_info.h>
+#include <asm/cache.h>
+#include <asm/page.h>
+
+/*
+ * The rudimentary linker script support in wasm-ld does not permit a section to
+ * be aligned directly. This workaround overcomes that limitation by immediately
+ * aligning the dot at the start of each section instead. Otherwise, it's
+ * functionally identical to the code in asm-generic/vmlinux.lds.h.
+ */
+#undef FW_LOADER_BUILT_IN_DATA
+#define FW_LOADER_BUILT_IN_DATA						\
+	. = ALIGN(8);							\
+	.builtin_fw : AT(ADDR(.builtin_fw) - LOAD_OFFSET) {		\
+		BOUNDED_SECTION_PRE_LABEL(.builtin_fw, _builtin_fw, __start, __end) \
+	}
+
+/*
+ * Linker scripts in wasm-ld currently does not support alignment sorting.
+ */
+#define SORT_BY_ALIGNMENT(files) files
+
+SECTIONS
+{
+	/* To refer to addres 0 in assembly, but as a relocation. */
+	zeroptr = 0;
+
+	. = CONFIG_KERNEL_START;
+
+	__init_begin = .;
+	HEAD_TEXT_SECTION
+	INIT_TEXT_SECTION(PAGE_SIZE)
+	INIT_DATA_SECTION(16)
+	PERCPU_SECTION(L1_CACHE_BYTES)
+	__init_end = .;
+
+	.text : {
+		_text = .;
+		_stext = .;
+		TEXT_TEXT
+		SCHED_TEXT
+		LOCK_TEXT
+		KPROBES_TEXT
+		ENTRY_TEXT
+		IRQENTRY_TEXT
+		SOFTIRQENTRY_TEXT
+		_etext = .;
+	}
+
+	_sdata = .;
+	RO_DATA(PAGE_SIZE)
+	RW_DATA(L1_CACHE_BYTES, PAGE_SIZE, THREAD_SIZE)
+	_edata = .;
+
+	EXCEPTION_TABLE(16)
+
+	BSS_SECTION(0, 0, 0)
+	_end = .;
+
+	MODINFO
+/*
+	Not supported by wasm-ld linker script hack:
+	STABS_DEBUG
+	DWARF_DEBUG
+	ELF_DETAILS
+*/
+
+	DISCARDS		// must be the last
+}
+
+/*
+ * Due to the way linker scripts are implemented in wasm-ld, any symbol-alias
+ * assignments have to happen after the symbol has been placed into the output.
+ */
+jiffies = jiffies_64;
diff --git a/arch/wasm/kernel/wasi.c b/arch/wasm/kernel/wasi.c
new file mode 100644
index 000000000..f96cf96b2
--- /dev/null
+++ b/arch/wasm/kernel/wasi.c
@@ -0,0 +1,361 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Host services through WASI preview 1: clocks, the console (fds 0-2), idle
+ * and yield (poll_oneoff, sched_yield), exit (proc_exit), the command line
+ * (the program arguments) and the initrd (a file in a preopened directory).
+ *
+ * The kernel is single-threaded and nothing runs while a host call is in
+ * progress (a suspended call only lets the host event loop run), so the
+ * static argument buffers below are never used by two calls at once. They
+ * are in the kernel image, below 4 GiB, as the wasm32 ABI of preview 1
+ * requires; console data that may be anywhere in RAM is copied through
+ * wasi_bounce when it is not.
+ */
+
+#include <linux/init.h>
+#include <linux/initrd.h>
+#include <linux/kernel.h>
+#include <linux/memblock.h>
+#include <linux/minmax.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+#include <linux/time64.h>
+#include <asm/irq.h>
+#include <asm/page.h>
+#include <asm/setup.h>
+#include <asm/wasi.h>
+#include <asm/wasm.h>
+
+#define WASI_EXIT_PANIC		253
+
+/* Subscription userdata, and the bits wasi_poll() returns. */
+#define WASI_POLL_CLOCK		BIT(0)
+#define WASI_POLL_STDIN		BIT(1)
+
+static u8 wasi_bounce[512];
+static struct wasi_iovec wasi_iov;
+static u32 wasi_nbytes;
+static u64 wasi_time;
+static struct wasi_subscription wasi_subs[2];
+static struct wasi_event wasi_events[2];
+static u32 wasi_nevents;
+
+/* stdin is closed, at end of file or not pollable: stop polling it. */
+static bool wasi_stdin_gone;
+
+/*
+ * A poll reported stdin readable and nothing has read it since, so one
+ * fd_read will not block. Needed because some hosts (uvwasi in node:wasi)
+ * answer a zero-timeout poll_oneoff with the clock event alone, without
+ * looking at ready descriptors, so re-probing before the read would never
+ * see the input the idle poll just reported.
+ */
+static bool wasi_stdin_readable;
+
+void __noreturn wasi_bad_ptr(const void *p)
+{
+	panic("wasi: argument at %px is above 4 GiB\n", p);
+}
+
+static bool wasi_low(const void *p, size_t len)
+{
+	return (unsigned long)p + len <= (unsigned long)U32_MAX + 1;
+}
+
+static u64 notrace wasi_clock(u32 id)
+{
+	if (wasi_clock_time_get(id, 1, wasi_ptr(&wasi_time)))
+		return 0;
+	return READ_ONCE(wasi_time);
+}
+
+u64 notrace wasm_cpu_clock_get_monotonic(void)
+{
+	return wasi_clock(WASI_CLOCK_MONOTONIC);
+}
+
+u64 wasm_clock_get_realtime(void)
+{
+	return wasi_clock(WASI_CLOCK_REALTIME);
+}
+
+void __noreturn wasm_halt(int code)
+{
+	wasi_proc_exit(code);
+}
+
+static ssize_t wasi_write(u32 fd, const u8 *buf, size_t count)
+{
+	size_t done = 0;
+
+	while (done < count) {
+		const u8 *p = buf + done;
+		size_t n = count - done;
+
+		if (!wasi_low(p, n)) {
+			n = min(n, sizeof(wasi_bounce));
+			memcpy(wasi_bounce, p, n);
+			p = wasi_bounce;
+		}
+		wasi_iov.buf = wasi_ptr(p);
+		wasi_iov.buf_len = n;
+		if (wasi_fd_write(fd, wasi_ptr(&wasi_iov), 1, wasi_ptr(&wasi_nbytes)))
+			return done ? done : -EIO;
+		if (!wasi_nbytes)
+			break;
+		done += wasi_nbytes;
+	}
+	return done;
+}
+
+void __noreturn wasm_panic(const char *msg)
+{
+	wasi_write(2, msg, strlen(msg));
+	wasi_write(2, "\n", 1);
+	wasi_proc_exit(WASI_EXIT_PANIC);
+}
+
+ssize_t wasm_console_write(const u8 *buf, size_t count)
+{
+	return wasi_write(1, buf, count);
+}
+
+/*
+ * poll_oneoff on the first @n entries of wasi_subs (stdin and/or a clock,
+ * tagged with WASI_POLL_* in userdata). Returns the WASI_POLL_* bits that
+ * fired. A host may also return no event at all (a spurious wakeup).
+ */
+static unsigned int wasi_poll(unsigned int n)
+{
+	unsigned int fired = 0;
+	u32 i;
+
+	if (wasi_poll_oneoff(wasi_ptr(wasi_subs), wasi_ptr(wasi_events), n,
+			     wasi_ptr(&wasi_nevents))) {
+		/* E.g. a host that cannot poll stdin: stop asking. */
+		for (i = 0; i < n; i++)
+			if (wasi_subs[i].userdata == WASI_POLL_STDIN)
+				wasi_stdin_gone = true;
+		return 0;
+	}
+	for (i = 0; i < min_t(u32, wasi_nevents, ARRAY_SIZE(wasi_events)); i++) {
+		struct wasi_event *ev = &wasi_events[i];
+
+		if (ev->userdata == WASI_POLL_STDIN && ev->error) {
+			wasi_stdin_gone = true;
+			continue;
+		}
+		fired |= ev->userdata;
+	}
+	if (fired & WASI_POLL_STDIN)
+		wasi_stdin_readable = true;
+	return fired;
+}
+
+static void wasi_sub_stdin(struct wasi_subscription *s)
+{
+	*s = (struct wasi_subscription){
+		.userdata = WASI_POLL_STDIN,
+		.tag = WASI_EVENTTYPE_FD_READ,
+		.u.fd_readwrite.fd = 0,
+	};
+}
+
+static void wasi_sub_clock(struct wasi_subscription *s, u64 timeout_ns)
+{
+	*s = (struct wasi_subscription){
+		.userdata = WASI_POLL_CLOCK,
+		.tag = WASI_EVENTTYPE_CLOCK,
+		.u.clock = {
+			.id = WASI_CLOCK_MONOTONIC,
+			.timeout = timeout_ns,
+			.precision = 1,
+		},
+	};
+}
+
+/* Is console input waiting? Never blocks. */
+static bool wasi_stdin_ready(void)
+{
+	if (wasi_stdin_gone)
+		return false;
+	wasi_sub_stdin(&wasi_subs[0]);
+	wasi_sub_clock(&wasi_subs[1], 0);
+	return wasi_poll(2) & WASI_POLL_STDIN;
+}
+
+static void wasi_raise_console_irq(void)
+{
+	WRITE_ONCE(wasm_host_irqs,
+		   READ_ONCE(wasm_host_irqs) | BIT(WASM_IRQ_CONSOLE));
+}
+
+ssize_t wasm_console_read(u8 *buf, size_t count)
+{
+	int err;
+
+	if (!count || (!wasi_stdin_readable && !wasi_stdin_ready()))
+		return 0;
+	wasi_stdin_readable = false;
+	wasi_iov.buf = wasi_ptr(wasi_bounce);
+	wasi_iov.buf_len = min(count, sizeof(wasi_bounce));
+	err = wasi_fd_read(0, wasi_ptr(&wasi_iov), 1, wasi_ptr(&wasi_nbytes));
+	if (err == WASI_EAGAIN)
+		return 0;
+	if (err || !wasi_nbytes) {
+		/* End of file: a closed stdin stays readable forever. */
+		wasi_stdin_gone = true;
+		return 0;
+	}
+	memcpy(buf, wasi_bounce, wasi_nbytes);
+	return wasi_nbytes;
+}
+
+void wasm_idle(long long timeout_ns)
+{
+	unsigned int n = 0;
+
+	if (!wasi_stdin_gone)
+		wasi_sub_stdin(&wasi_subs[n++]);
+	if (timeout_ns >= 0)
+		wasi_sub_clock(&wasi_subs[n++], timeout_ns);
+	else if (!n)
+		/* Nothing to wait for: poll_oneoff needs a subscription. */
+		wasi_sub_clock(&wasi_subs[n++], 60 * NSEC_PER_SEC);
+
+	if (wasi_poll(n) & WASI_POLL_STDIN)
+		wasi_raise_console_irq();
+}
+
+void wasm_yield(void)
+{
+	wasi_sched_yield();
+	/* A host that cannot raise WASM_IRQ_CONSOLE by itself (plain WASI). */
+	if (wasi_stdin_ready())
+		wasi_raise_console_irq();
+}
+
+/*
+ * The command line is the program arguments after argv[0], joined with
+ * spaces: `wasmtime run vmlinux32.wasm console=hvc0 rdinit=/init`, or one
+ * argument holding the whole line (what the unkernel host passes).
+ */
+static char wasi_argv_buf[4 * COMMAND_LINE_SIZE] __initdata;
+static u32 wasi_argv[64] __initdata;
+static u32 wasi_argc __initdata;
+static u32 wasi_argv_size __initdata;
+
+void __init wasm_setup_cmdline(void)
+{
+	unsigned long lo = (unsigned long)wasi_argv_buf;
+	unsigned long hi = lo + sizeof(wasi_argv_buf);
+	size_t len = 0;
+	u32 i;
+
+	if (wasi_args_sizes_get(wasi_ptr(&wasi_argc), wasi_ptr(&wasi_argv_size)))
+		return;
+	if (wasi_argc > ARRAY_SIZE(wasi_argv) ||
+	    wasi_argv_size > sizeof(wasi_argv_buf)) {
+		pr_warn("wasi: command line too long (%u arguments, %u bytes), ignored\n",
+			wasi_argc, wasi_argv_size);
+		return;
+	}
+	if (wasi_args_get(wasi_ptr(wasi_argv), wasi_ptr(wasi_argv_buf)))
+		return;
+
+	boot_command_line[0] = '\0';
+	for (i = 1; i < wasi_argc; i++) {
+		unsigned long arg = wasi_argv[i];
+
+		if (arg < lo || arg >= hi)
+			continue;
+		len += scnprintf(boot_command_line + len, COMMAND_LINE_SIZE - len,
+				 "%s%.*s", len ? " " : "", (int)(hi - arg),
+				 (const char *)arg);
+	}
+	if (len >= COMMAND_LINE_SIZE - 1)
+		pr_warn("wasi: command line truncated to %d bytes\n",
+			COMMAND_LINE_SIZE - 1);
+}
+
+#ifdef CONFIG_BLK_DEV_INITRD
+/*
+ * The initrd is the file "initrd" in the first preopened directory (fd 3
+ * and up) that has one: `wasmtime run --dir boot::/ vmlinux32.wasm ...`
+ * with the image at boot/initrd. The unkernel host preopens "/" with the
+ * bundled or given initramfs as "initrd". The file is read into memory
+ * that memblock reserves, below 4 GiB.
+ */
+static const char wasi_initrd_name[] __initconst = "initrd";
+static struct wasi_prestat wasi_prestat __initdata;
+static struct wasi_filestat wasi_filestat __initdata;
+static u32 wasi_initrd_fd __initdata;
+
+static int __init wasi_read_initrd(u32 fd)
+{
+	phys_addr_t base;
+	u64 size, done = 0;
+
+	if (wasi_fd_filestat_get(fd, wasi_ptr(&wasi_filestat)))
+		return -EIO;
+	if (wasi_filestat.filetype != WASI_FILETYPE_REGULAR_FILE)
+		return -EINVAL;
+	size = wasi_filestat.size;
+	if (!size)
+		return 0;
+
+	base = memblock_phys_alloc_range(size, PAGE_SIZE, 0,
+					 min_t(phys_addr_t, memory_end, SZ_4G));
+	if (!base) {
+		pr_err("initrd: cannot allocate %llu MiB\n", size >> 20);
+		return -ENOMEM;
+	}
+	while (done < size) {
+		wasi_iov.buf = wasi_ptr(__va(base + done));
+		wasi_iov.buf_len = min_t(u64, size - done, SZ_1G);
+		if (wasi_fd_read(fd, wasi_ptr(&wasi_iov), 1,
+				 wasi_ptr(&wasi_nbytes)) || !wasi_nbytes) {
+			memblock_phys_free(base, size);
+			return -EIO;
+		}
+		done += wasi_nbytes;
+	}
+
+	initrd_start = (unsigned long)__va(base);
+	initrd_end = initrd_start + size;
+	initrd_below_start_ok = 1;
+	return 0;
+}
+
+void __init wasm_load_initrd(void)
+{
+	u32 dir;
+	int err;
+
+	for (dir = 3; dir < 3 + 64; dir++) {
+		err = wasi_fd_prestat_get(dir, wasi_ptr(&wasi_prestat));
+		if (err == WASI_EBADF)
+			break;
+		if (err || wasi_prestat.tag != WASI_PREOPENTYPE_DIR)
+			continue;
+		err = wasi_path_open(dir, WASI_LOOKUP_SYMLINK_FOLLOW,
+				     wasi_ptr(wasi_initrd_name),
+				     strlen(wasi_initrd_name), 0,
+				     WASI_RIGHT_FD_READ | WASI_RIGHT_FD_FILESTAT_GET,
+				     0, 0, wasi_ptr(&wasi_initrd_fd));
+		if (err == WASI_ENOENT)
+			continue;
+		if (err) {
+			pr_warn("initrd: cannot open it in preopen %u (WASI errno %d)\n",
+				dir, err);
+			continue;
+		}
+		err = wasi_read_initrd(wasi_initrd_fd);
+		wasi_fd_close(wasi_initrd_fd);
+		if (err)
+			pr_err("initrd: cannot read it (%d)\n", err);
+		return;
+	}
+}
+#endif
