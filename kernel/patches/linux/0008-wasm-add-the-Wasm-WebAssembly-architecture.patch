+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#define COMPILE_OFFSETS
+
+#include <linux/sched.h>
+#include <linux/kbuild.h>
+#include <asm/thread_info.h>
+#include <asm/ptrace.h>
+#include <asm/processor.h>
+
+void asm_offsets(void);
+
+void asm_offsets(void)
+{
+	DEFINE(_WASM_PAGE_SIZE, WASM_PAGE_SIZE);
+	OFFSET(TASK_STRUCT_STACK, task_struct, stack);
+	/* Kernel C stack starts below pt_regs at the top of the stack area. */
+	DEFINE(THREAD_STACK_START,
+	       ALIGN_DOWN(THREAD_SIZE - sizeof(struct pt_regs), STACK_ALIGN));
