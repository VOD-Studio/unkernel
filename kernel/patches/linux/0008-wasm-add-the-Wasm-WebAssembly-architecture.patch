diff --git a/arch/wasm/include/asm/uaccess.h b/arch/wasm/include/asm/uaccess.h
new file mode 100644
index 000000000..4ec3a2826
--- /dev/null
+++ b/arch/wasm/include/asm/uaccess.h
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef _ASM_WASM_UACCESS_H
+#define _ASM_WASM_UACCESS_H
+
+/*
+ * User memory is not addressable by the kernel: every access walks the
+ * current task's page tables in software (arch/wasm/mm/uaccess.c), faulting
+ * pages in through handle_mm_fault() like a hardware page fault would.
+ */
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+#include <linux/unaligned.h>
+#include <asm/errno.h>
+#include <asm/rwonce.h>
+
+unsigned long raw_copy_from_user(void *to, const void __user *from,
+				 unsigned long n);
+unsigned long raw_copy_to_user(void __user *to, const void *from,
+			       unsigned long n);
+
+unsigned long __clear_user(void __user *to, unsigned long n);
+#define __clear_user __clear_user
+
+/*
+ * Translate a user address to a kernel pointer valid for @len bytes (which
+ * must not cross a page). Returns NULL when the page is not mapped with the
+ * required access and may not be faulted in (pagefault_disabled()).
+ */
+void *kw_user_addr(const void __user *uaddr, size_t len, bool write);
+
+/*
+ * Aligned 1-, 2-, 4- and 8-byte accesses never cross a page and use a
+ * single scalar load or store (single-copy atomic on a shared memory, as
+ * riscv's loads and stores are; raw_copy_*_user()'s memcpy compiles to
+ * wasm memory.copy, which the spec does not make atomic). Unaligned ones
+ * may cross a page, so they go through raw_copy_*_user().
+ */
+static inline int __get_user_fn(size_t size, const void __user *from, void *to)
+{
+	if (likely(!((unsigned long)from & (size - 1)))) {
+		void *p = kw_user_addr(from, size, false);
+
+		if (unlikely(!p))
+			return -EFAULT;
+		switch (size) {
+		case 1:
+			*(u8 *)to = READ_ONCE(*(const u8 *)p);
+			return 0;
+		case 2:
+			*(u16 *)to = READ_ONCE(*(const u16 *)p);
+			return 0;
+		case 4:
+			*(u32 *)to = READ_ONCE(*(const u32 *)p);
+			return 0;
+		case 8:
+			*(u64 *)to = READ_ONCE(*(const u64 *)p);
+			return 0;
+		}
+	}
+	return unlikely(raw_copy_from_user(to, from, size)) ? -EFAULT : 0;
+}
+#define __get_user_fn(sz, u, k)	__get_user_fn(sz, u, k)
+
+static inline int __put_user_fn(size_t size, void __user *to, void *from)
+{
+	if (likely(!((unsigned long)to & (size - 1)))) {
+		void *p = kw_user_addr(to, size, true);
+
+		if (unlikely(!p))
+			return -EFAULT;
+		switch (size) {
+		case 1:
+			WRITE_ONCE(*(u8 *)p, *(const u8 *)from);
+			return 0;
+		case 2:
+			WRITE_ONCE(*(u16 *)p, *(const u16 *)from);
+			return 0;
+		case 4:
+			WRITE_ONCE(*(u32 *)p, *(const u32 *)from);
+			return 0;
+		case 8:
+			WRITE_ONCE(*(u64 *)p, *(const u64 *)from);
+			return 0;
+		}
+	}
+	return unlikely(raw_copy_to_user(to, from, size)) ? -EFAULT : 0;
+}
+#define __put_user_fn(sz, u, k)	__put_user_fn(sz, u, k)
+
+#define __get_kernel_nofault(dst, src, type, err_label)			\
+do {									\
+	*((type *)dst) = get_unaligned((type *)(src));			\
+	if (0) /* make sure the label looks used to the compiler */	\
+		goto err_label;						\
+} while (0)
+
+#define __put_kernel_nofault(dst, src, type, err_label)			\
+do {									\
+	put_unaligned(*((type *)src), (type *)(dst));			\
+	if (0) /* make sure the label looks used to the compiler */	\
+		goto err_label;						\
+} while (0)
+
+#include <asm-generic/uaccess.h>
+
+#endif /* _ASM_WASM_UACCESS_H */
