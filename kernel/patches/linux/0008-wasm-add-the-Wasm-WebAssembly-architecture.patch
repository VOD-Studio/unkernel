diff --git a/arch/wasm/mm/fault.c b/arch/wasm/mm/fault.c
new file mode 100644
index 000000000..553d1c3e5
--- /dev/null
+++ b/arch/wasm/mm/fault.c
@@ -0,0 +1,313 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Page faults and user memory access.
+ *
+ * User memory is reachable only through the Sv39 page tables. Faults come
+ * from two places: the kwemu CPU (KW_EV_FAULT while running user code) and
+ * the uaccess helpers below, which walk the tables in software and fault
+ * pages in as a hardware page-table walker + fault handler would.
+ */
+
+#include <linux/mm.h>
+#include <linux/mman.h>
+#include <linux/perf_event.h>
+#include <linux/sched/signal.h>
+#include <linux/uaccess.h>
+#include <linux/hugetlb.h>
+#include <asm/entry.h>
+#include <asm/kw_emu.h>
+#include <asm/pgtable.h>
+#include <asm/tlbflush.h>
+
+extern struct kw_cpu *const wasm_kw_cpu;
+
+/* Find the PTE for @addr in @mm, or NULL if no page table covers it. */
+static pte_t *kw_walk(struct mm_struct *mm, unsigned long addr)
+{
+	pgd_t *pgd = pgd_offset(mm, addr);
+	p4d_t *p4d = p4d_offset(pgd, addr);
+	pud_t *pud = pud_offset(p4d, addr);
+	pmd_t *pmd;
+
+	if (pud_none(*pud) || !pud_present(*pud))
+		return NULL;
+	pmd = pmd_offset(pud, addr);
+	if (pmd_none(*pmd) || !(pmd_val(*pmd) & _PAGE_PRESENT))
+		return NULL;
+	return pte_offset_kernel(pmd, addr);
+}
+
+static bool access_error(unsigned int access, struct vm_area_struct *vma)
+{
+	switch (access) {
+	case KW_ACCESS_EXEC:
+		return !(vma->vm_flags & VM_EXEC);
+	case KW_ACCESS_WRITE:
+		return !(vma->vm_flags & VM_WRITE);
+	default:
+		return !(vma->vm_flags & (VM_READ | VM_WRITE));
+	}
+}
+
+/*
+ * What a hardware walker with Svadu would do: the mapping allows the access
+ * but A (or D for a store) is clear. Returns true if fixed.
+ */
+static bool kw_fixup_ad(struct mm_struct *mm, unsigned long addr,
+			unsigned int access)
+{
+	pte_t *ptep = kw_walk(mm, addr);
+	unsigned long v, need;
+
+	if (!ptep)
+		return false;
+	v = pte_val(*ptep);
+	if (!(v & _PAGE_PRESENT) || !(v & _PAGE_USER))
+		return false;
+	need = access == KW_ACCESS_WRITE ? _PAGE_WRITE :
+	       access == KW_ACCESS_EXEC ? _PAGE_EXEC : _PAGE_READ;
+	if (!(v & need))
+		return false;
+	need = _PAGE_ACCESSED | (access == KW_ACCESS_WRITE ? _PAGE_DIRTY : 0);
+	if ((v & need) != need)
+		set_pte(ptep, __pte(v | need));
+	kw_flush_tlb_range(wasm_kw_cpu, addr & PAGE_MASK,
+			   (addr & PAGE_MASK) + PAGE_SIZE);
+	return true;
+}
+
+/*
+ * Fault in @addr for @access. Returns 0 on success, otherwise the
+ * VM_FAULT_* error (or VM_FAULT_SIGSEGV with *code set) for the caller.
+ */
+static vm_fault_t kw_handle_fault(struct pt_regs *regs, unsigned long addr,
+				  unsigned int access, bool user, int *code)
+{
+	struct mm_struct *mm = current->mm;
+	unsigned int flags = FAULT_FLAG_DEFAULT;
+	struct vm_area_struct *vma;
+	vm_fault_t fault;
+
+	*code = SEGV_MAPERR;
+	/*
+	 * Only a fatal signal ends a kernel access (the uaccess walk, below),
+	 * so it also waits killable only, as GUP without FOLL_INTERRUPTIBLE:
+	 * with FAULT_FLAG_INTERRUPTIBLE any pending signal would end each
+	 * wait at once (handle_userfault()) and the retries would spin, and
+	 * the kernel does not poll the tick in such a loop, so on UP the task
+	 * that would resolve the fault might never run.
+	 */
+	if (user)
+		flags |= FAULT_FLAG_USER;
+	else
+		flags &= ~FAULT_FLAG_INTERRUPTIBLE;
+	if (access == KW_ACCESS_WRITE)
+		flags |= FAULT_FLAG_WRITE;
+	else if (access == KW_ACCESS_EXEC)
+		flags |= FAULT_FLAG_INSTRUCTION;
+
+	perf_sw_event(PERF_COUNT_SW_PAGE_FAULTS, 1, regs, addr);
+
+retry:
+	vma = lock_mm_and_find_vma(mm, addr, regs);
+	if (unlikely(!vma))
+		return VM_FAULT_SIGSEGV;
+
+	if (unlikely(access_error(access, vma))) {
+		mmap_read_unlock(mm);
+		*code = SEGV_ACCERR;
+		return VM_FAULT_SIGSEGV;
+	}
+
+	fault = handle_mm_fault(vma, addr, flags, regs);
+
+	/*
+	 * fault_signal_pending(), with @user for user_mode(regs): the uaccess
+	 * walk passes no regs. Only a fatal signal ends a kernel access (it
+	 * fails with EFAULT); any signal ends a user fault, which comes again
+	 * if the instruction runs again after the handler.
+	 */
+	if (unlikely((fault & VM_FAULT_RETRY) &&
+		     (fatal_signal_pending(current) ||
+		      (user && signal_pending(current)))))
+		return user ? 0 : VM_FAULT_SIGSEGV;
+
+	if (fault & VM_FAULT_COMPLETED)
+		return 0;
+
+	if (unlikely(fault & VM_FAULT_RETRY)) {
+		flags |= FAULT_FLAG_TRIED;
+		goto retry;
+	}
+
+	mmap_read_unlock(mm);
+	return fault & VM_FAULT_ERROR;
+}
+
+void do_user_page_fault(struct pt_regs *regs, unsigned long addr,
+			unsigned int access)
+{
+	struct mm_struct *mm = current->mm;
+	vm_fault_t fault;
+	int code;
+
+	if (addr < TASK_SIZE && kw_fixup_ad(mm, addr, access))
+		return;
+
+	if (addr >= TASK_SIZE) {
+		force_sig_fault(SIGSEGV, SEGV_MAPERR, (void __user *)addr);
+		return;
+	}
+
+	fault = kw_handle_fault(regs, addr, access, true, &code);
+	if (likely(!fault))
+		return;
+
+	if (fault & VM_FAULT_OOM)
+		pagefault_out_of_memory();
+	else if (fault & (VM_FAULT_SIGBUS | VM_FAULT_HWPOISON |
+			  VM_FAULT_HWPOISON_LARGE))
+		force_sig_fault(SIGBUS, BUS_ADRERR, (void __user *)addr);
+	else {
+		if (show_unhandled_signals && unhandled_signal(current, SIGSEGV))
+			pr_info_ratelimited("%s[%d]: segfault at %lx pc %llx sp %llx ra %llx (%s)\n",
+					    current->comm, task_pid_nr(current),
+					    addr, regs->user.pc, regs->user.x[2],
+					    regs->user.x[1],
+					    access == KW_ACCESS_WRITE ? "write" :
+					    access == KW_ACCESS_EXEC ? "exec" : "read");
+		force_sig_fault(SIGSEGV, code, (void __user *)addr);
+	}
+}
+
+/* ---------------------------------------------------------------------- */
+
+void *kw_user_addr(const void __user *uaddr, size_t len, bool write)
+{
+	unsigned long addr = (unsigned long)uaddr;
+	struct mm_struct *mm = current->mm;
+	int rounds = 0, code;
+
+	/*
+	 * As a hardware MMU retries the access after every fault it took,
+	 * walk again for as long as the fault handler succeeds: another
+	 * thread of the mm may take the access away again before the walk
+	 * (on SMP: MADV_DONTNEED zaps under the mmap read lock, fork
+	 * write-protects for COW, mprotect(), migration), or change the PTE
+	 * while the fault sleeps, which then succeeds without mapping it.
+	 * Only a real error (SIGSEGV, SIGBUS, OOM), a fatal signal (checked
+	 * each time round, as GUP does, so that the loop stays killable) or
+	 * pagefault_disable() ends it. The 10000 rounds are a backstop for a
+	 * fault handler that reports success without ever mapping the page:
+	 * on UP nothing else would end the loop (no other task runs, and the
+	 * kernel does not poll the tick). Under host load other threads were
+	 * seen to take the page away up to 17 times in a row.
+	 */
+	if (!mm || addr >= TASK_SIZE || TASK_SIZE - addr < len)
+		return NULL;
+
+	for (;;) {
+		pte_t *ptep = kw_walk(mm, addr);
+		unsigned long v = ptep ? pte_val(*ptep) : 0;
+		unsigned long need = _PAGE_PRESENT | _PAGE_USER |
+				     (write ? _PAGE_WRITE : _PAGE_READ);
+
+		if ((v & need) == need) {
+			unsigned long ad = _PAGE_ACCESSED |
+					   (write ? _PAGE_DIRTY : 0);
+
+			if ((v & ad) != ad) {
+				set_pte(ptep, __pte(v | ad));
+				kw_flush_tlb_range(wasm_kw_cpu, addr & PAGE_MASK,
+						   (addr & PAGE_MASK) + PAGE_SIZE);
+			}
+			return (void *)((__page_val_to_pfn(v) << PAGE_SHIFT) |
+					(addr & ~PAGE_MASK));
+		}
+
+		if (faulthandler_disabled())
+			return NULL;
+		if (rounds) {
+			/* Lost the page again since the last fault. */
+			if (fatal_signal_pending(current))
+				return NULL;
+			if (rounds >= 10000) {
+				pr_warn_once("%s[%d]: %d faults at %lx did not map it (pte %lx)\n",
+					     current->comm, task_pid_nr(current),
+					     rounds, addr, v);
+				return NULL;
+			}
+			cond_resched();
+		}
+		rounds++;
+		if (kw_handle_fault(NULL, addr,
+				    write ? KW_ACCESS_WRITE : KW_ACCESS_READ,
+				    false, &code))
+			return NULL;
+	}
+}
+
+static inline unsigned long chunk_len(unsigned long addr, unsigned long n)
+{
+	unsigned long left = PAGE_SIZE - (addr & ~PAGE_MASK);
+
+	return n < left ? n : left;
+}
+
+unsigned long raw_copy_from_user(void *to, const void __user *from,
+				 unsigned long n)
+{
+	unsigned long addr = (unsigned long)from;
+
+	while (n) {
+		unsigned long len = chunk_len(addr, n);
+		void *p = kw_user_addr((void __user *)addr, len, false);
+
+		if (!p)
+			break;
+		memcpy(to, p, len);
+		to += len;
+		addr += len;
+		n -= len;
+	}
+	return n;
+}
+EXPORT_SYMBOL(raw_copy_from_user);
+
+unsigned long raw_copy_to_user(void __user *to, const void *from,
+			       unsigned long n)
+{
+	unsigned long addr = (unsigned long)to;
+
+	while (n) {
+		unsigned long len = chunk_len(addr, n);
+		void *p = kw_user_addr((void __user *)addr, len, true);
+
+		if (!p)
+			break;
+		memcpy(p, from, len);
+		from += len;
+		addr += len;
+		n -= len;
+	}
+	return n;
+}
+EXPORT_SYMBOL(raw_copy_to_user);
+
+unsigned long __clear_user(void __user *to, unsigned long n)
+{
+	unsigned long addr = (unsigned long)to;
+
+	while (n) {
+		unsigned long len = chunk_len(addr, n);
+		void *p = kw_user_addr((void __user *)addr, len, true);
+
+		if (!p)
+			break;
+		memset(p, 0, len);
+		addr += len;
+		n -= len;
+	}
+	return n;
+}
+EXPORT_SYMBOL(__clear_user);
diff --git a/arch/wasm/mm/init.c b/arch/wasm/mm/init.c
new file mode 100644
index 000000000..dd45f476f
--- /dev/null
+++ b/arch/wasm/mm/init.c
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#include <linux/linkage.h>
+#include <linux/init.h>
+#include <linux/memblock.h>
+#include <linux/mm.h>
+#include <linux/export.h>
+#include <asm/page.h>
+#include <asm/pgalloc.h>
+
+/* init_mm's page table: never holds anything (kernel memory is unmapped). */
+pgd_t swapper_pg_dir[PTRS_PER_PGD] __page_aligned_bss;
+
+void __init arch_zone_limits_init(unsigned long *max_zone_pfns)
+{
+	max_zone_pfns[ZONE_NORMAL] = memory_end >> PAGE_SHIFT;
+}
+
+void __init paging_init(void)
+{
+}
+
+pgd_t *pgd_alloc(struct mm_struct *mm)
+{
+	return __pgd_alloc(mm, 0);
+}
+
+/* protection_map: same as riscv. */
+static const pgprot_t protection_map[16] = {
+	[VM_NONE]					= PAGE_NONE,
+	[VM_READ]					= PAGE_READ,
+	[VM_WRITE]					= PAGE_COPY,
+	[VM_WRITE | VM_READ]				= PAGE_COPY,
+	[VM_EXEC]					= PAGE_EXEC,
+	[VM_EXEC | VM_READ]				= PAGE_READ_EXEC,
+	[VM_EXEC | VM_WRITE]				= PAGE_COPY_EXEC,
+	[VM_EXEC | VM_WRITE | VM_READ]			= PAGE_COPY_EXEC,
+	[VM_SHARED]					= PAGE_NONE,
+	[VM_SHARED | VM_READ]				= PAGE_READ,
+	[VM_SHARED | VM_WRITE]				= PAGE_SHARED,
+	[VM_SHARED | VM_WRITE | VM_READ]		= PAGE_SHARED,
+	[VM_SHARED | VM_EXEC]				= PAGE_EXEC,
+	[VM_SHARED | VM_EXEC | VM_READ]			= PAGE_READ_EXEC,
+	[VM_SHARED | VM_EXEC | VM_WRITE]		= PAGE_SHARED_EXEC,
+	[VM_SHARED | VM_EXEC | VM_WRITE | VM_READ]	= PAGE_SHARED_EXEC
+};
+DECLARE_VM_GET_PAGE_PROT
diff --git a/arch/wasm/mm/sigpage.c b/arch/wasm/mm/sigpage.c
new file mode 100644
index 000000000..51408f5cd
--- /dev/null
+++ b/arch/wasm/mm/sigpage.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The signal return trampoline page (there is no vDSO). Mapped read+exec
+ * into every process at exec; signal handlers return to it via ra.
+ */
+
+#include <linux/binfmts.h>
+#include <linux/elf.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/mman.h>
+
+static struct page *sigpage;
+
+static const struct vm_special_mapping sigpage_mapping = {
+	.name = "[sigpage]",
+	.pages = &sigpage,
+};
+
+static int __init sigpage_init(void)
+{
+	u32 *insn;
+
+	sigpage = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!sigpage)
+		return -ENOMEM;
+	insn = page_address(sigpage);
+	insn[0] = 0x08b00893;	/* li a7, 139 (__NR_rt_sigreturn) */
+	insn[1] = 0x00000073;	/* ecall */
+	return 0;
+}
+arch_initcall(sigpage_init);
+
+int arch_setup_additional_pages(struct linux_binprm *bprm, int uses_interp)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	unsigned long addr;
+	int ret = 0;
+
+	if (mmap_write_lock_killable(mm))
+		return -EINTR;
+
+	addr = get_unmapped_area(NULL, 0, PAGE_SIZE, 0, 0);
+	if (IS_ERR_VALUE(addr)) {
+		ret = addr;
+		goto out;
+	}
+
+	vma = _install_special_mapping(mm, addr, PAGE_SIZE,
+				       VM_READ | VM_EXEC | VM_MAYREAD | VM_MAYEXEC,
+				       &sigpage_mapping);
+	if (IS_ERR(vma)) {
+		ret = PTR_ERR(vma);
+		goto out;
+	}
+	mm->context.sigpage = addr;
+out:
+	mmap_write_unlock(mm);
+	return ret;
+}
diff --git a/arch/wasm/mm/tlb.c b/arch/wasm/mm/tlb.c
new file mode 100644
index 000000000..d4509d6b8
--- /dev/null
+++ b/arch/wasm/mm/tlb.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The kwemu software CPU: one per (single) kernel CPU. Its translation cache
+ * plays the role of the TLB for the currently loaded user page table.
+ */
+
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <asm/hwcap.h>
+#include <asm/kw_emu.h>
+#include <asm/mmu_context.h>
+#include <asm/tlbflush.h>
+#include <asm/wasm.h>
+
+static u64 kw_cpu_storage[KW_CPU_SIZE / sizeof(u64)] __aligned(64);
+struct kw_cpu *const wasm_kw_cpu = (struct kw_cpu *)kw_cpu_storage;
+
+/* The mm whose page table the emulator currently walks. */
+static struct mm_struct *kw_loaded_mm;
+
+static int __init kw_cpu_setup(void)
+{
+	struct kw_cpu *cpu = wasm_kw_cpu;
+
+	if (kw_abi_version() != KW_ABI_VERSION)
+		panic("kwemu ABI version %u, kernel expects %u",
+		      kw_abi_version(), KW_ABI_VERSION);
+	kw_cpu_init(cpu);
+	kw_isa_init(cpu);
+	cpu->phys_base = 0;
+	cpu->irq_pending = &wasm_host_irqs;
+	kw_set_pgd(cpu, __pa(swapper_pg_dir));
+	kw_loaded_mm = &init_mm;
+	return 0;
+}
+early_initcall(kw_cpu_setup);
+
+void switch_mm(struct mm_struct *prev, struct mm_struct *next,
+	       struct task_struct *task)
+{
+	if (next == kw_loaded_mm)
+		return;
+	kw_set_pgd(wasm_kw_cpu, __pa(next->pgd));
+	kw_loaded_mm = next;
+}
+
+void flush_tlb_all(void)
+{
+	kw_flush_tlb_all(wasm_kw_cpu);
+}
+
+void flush_tlb_mm(struct mm_struct *mm)
+{
+	if (mm == kw_loaded_mm)
+		kw_flush_tlb_all(wasm_kw_cpu);
+}
+
+void flush_tlb_page(struct vm_area_struct *vma, unsigned long addr)
+{
+	if (vma->vm_mm == kw_loaded_mm)
+		kw_flush_tlb_range(wasm_kw_cpu, addr & PAGE_MASK,
+				   (addr & PAGE_MASK) + PAGE_SIZE);
+}
+
+void flush_tlb_range(struct vm_area_struct *vma, unsigned long start,
+		     unsigned long end)
+{
+	if (vma->vm_mm == kw_loaded_mm)
+		kw_flush_tlb_range(wasm_kw_cpu, start, end);
+}
+
+void update_mmu_cache_range(struct vm_fault *vmf, struct vm_area_struct *vma,
+			    unsigned long addr, pte_t *ptep, unsigned int nr)
+{
+	if (vma->vm_mm == kw_loaded_mm)
+		kw_flush_tlb_range(wasm_kw_cpu, addr,
+				   addr + (unsigned long)nr * PAGE_SIZE);
+}
+
+/* mm teardown: never leave the emulator pointing at a freed page table. */
+void kw_mm_release(struct mm_struct *mm)
+{
+	if (mm == kw_loaded_mm) {
+		kw_set_pgd(wasm_kw_cpu, __pa(swapper_pg_dir));
+		kw_loaded_mm = &init_mm;
+	}
+}
