From 4d4823014d2776b93350a4dd7ef5de671e1a6199 Mon Sep 17 00:00:00 2001
From: Joel Severin <joel.severin@icemanor.se>
Date: Thu, 19 Feb 2026 22:43:37 +0100
Subject: [PATCH] NOMERGE: kbuild: Provide Wasm support in mk_elfconfig

This is some kind of emulation for the modpost parts of Kbuild which
currently assumes that ELF is used by all targets.
---
 scripts/mod/mk_elfconfig.c |  9 +++++++--
 scripts/mod/modpost.c      | 13 +++++++++++++
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/scripts/mod/mk_elfconfig.c b/scripts/mod/mk_elfconfig.c
index e8cee4e4b..655b368c0 100644
--- a/scripts/mod/mk_elfconfig.c
+++ b/scripts/mod/mk_elfconfig.c
@@ -13,10 +13,15 @@ main(int argc, char **argv)
 		fprintf(stderr, "Error: input truncated\n");
 		return 1;
 	}
-	if (memcmp(ei, ELFMAG, SELFMAG) != 0) {
-		fprintf(stderr, "Error: not ELF\n");
+
+	if (memcmp(ei, "\x00" "asm", 4UL) == 0) {
+		/* Wasm (not ELF) - provide some emulation. */
+		printf("#define KERNEL_ELFCLASS ELFCLASS32\n");
+	} else if (memcmp(ei, ELFMAG, SELFMAG) != 0) {
+		fprintf(stderr, "Error: not ELF, nor Wasm\n");
 		return 1;
 	}
+
 	switch (ei[EI_CLASS]) {
 	case ELFCLASS32:
 		printf("#define KERNEL_ELFCLASS ELFCLASS32\n");
diff --git a/scripts/mod/modpost.c b/scripts/mod/modpost.c
index 75374c64b..f009a687d 100644
--- a/scripts/mod/modpost.c
+++ b/scripts/mod/modpost.c
@@ -74,6 +74,8 @@ static unsigned int nr_unresolved;
 
 #define MODULE_NAME_LEN (64 - sizeof(Elf_Addr))
 
+static void write_vmlinux_export_c_file(struct module *mod);
+
 void modpost_log(bool is_error, struct module *mod, const char *fmt, ...)
 {
 	va_list arglist;
@@ -431,6 +433,17 @@ static int parse_elf(struct elf_info *info, const char *filename)
 		perror(filename);
 		exit(1);
 	}
+
+	/* Generate a dummy for vmlinux on Wasm. */
+	if (strcmp(filename, "vmlinux.o") == 0 &&
+	    info->size >= 4UL &&
+	    memcmp(hdr, "\x00" "asm", 4UL) == 0) {
+		struct module *mod =
+			new_module(filename, strlen(filename) - strlen(".o"));
+		write_vmlinux_export_c_file(mod);
+		exit(0);
+	}
+
 	info->hdr = hdr;
 	if (info->size < sizeof(*hdr)) {
 		/* file too small, assume this is an empty .o file */
-- 
2.56.0

